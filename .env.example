# RODEO — variables de entorno
# ─────────────────────────────────────────────────────────────
# Copia este archivo a .env.local y pon tu key real:
#     cp .env.example .env.local
# .env.local NUNCA se sube a git (está en .gitignore).

# OBLIGATORIA — tu API key de OpenCode Zen (https://opencode.ai)
# Sin esto, /api/chat responde "missing_api_key".
OPENCODE_API_KEY=sk-pon-tu-key-de-opencode-aqui

# VOZ (opcional) — key gratis de Deepgram (https://deepgram.com) para la voz
# natural del coach. $200 de crédito gratis sin tarjeta. Sin esto, la app usa
# la voz robótica del sistema. La key vive SOLO en el servidor (api/tts.js).
DEEPGRAM_API_KEY=pon-tu-key-de-deepgram-aqui
# TTS_MODEL=aura-2-apollo-en   # voz por defecto; descomenta para cambiarla

# OPCIONALES — si no las pones, api/chat.js usa estos mismos defaults.
# OJO: si defines MODEL_CHAT aquí (o en el dashboard de Vercel), GANA sobre el
# default del código. Si TALK se siente lento, revisa que no haya quedado un
# MODEL_CHAT=kimi-k2.6 viejo pisando el default.
MODEL_CHAT=claude-haiku-4-5
MODEL_CREATIVE=kimi-k2.7-code

# OPCIONAL — PIN de acceso. Si lo defines, el frontend debe mandarlo
# en el header x-rodeo-pass. (El index.html ya manda RODEO2026.)
APP_PASS=RODEO2026
