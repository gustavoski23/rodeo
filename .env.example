# RODEO — variables de entorno
# ─────────────────────────────────────────────────────────────
# Copia este archivo a .env.local y pon tu key real:
#     cp .env.example .env.local
# .env.local NUNCA se sube a git (está en .gitignore).

# OBLIGATORIA — tu API key de OpenCode Zen (https://opencode.ai)
# Sin esto, /api/chat responde "missing_api_key".
OPENCODE_API_KEY=sk-pon-tu-key-de-opencode-aqui

# VOZ (opcional) — key gratis de Deepgram (https://deepgram.com) para la voz
# natural del coach. $200 de crédito gratis sin tarjeta. Sin esto, la app usa
# la voz robótica del sistema. La key vive SOLO en el servidor (api/tts.js).
DEEPGRAM_API_KEY=pon-tu-key-de-deepgram-aqui
# TTS_MODEL=aura-2-apollo-en   # voz por defecto; descomenta para cambiarla

# AUDIOLIBRO (opcional) — key de Fish Audio (https://fish.audio) para hornear
# la narración en español latino del libro interactivo "La Golondrina". Se usa
# SOLO en el script de horneado (scripts/hornear-audiolibro.mjs), nunca en el
# frontend ni en runtime: el audio se genera una vez y aterriza como assets en
# public/libro/audio/. El modelo va en la CABECERA 'model' (s2.1-pro-free hasta
# el 31-ago-2026, luego s2.1-pro). La alineación palabra-por-palabra la hace
# Deepgram (DEEPGRAM_API_KEY, arriba), no Fish.
FISH_API_KEY=pon-tu-key-de-fish-audio-aqui

# OPCIONALES — modelos del endpoint OpenCode Go. Los aliases legacy MODEL_CHAT
# y MODEL_CREATIVE aún se aceptan si contienen un modelo compatible con Go.
MODEL_GO_CHAT=gpt-5.6-luna
MODEL_GO_CREATIVE=gpt-5.6-luna
# Fallback gratuito si Go falla por saldo/cuota, región o indisponibilidad.
MODEL_FALLBACK=mimo-v2.5-free

# OPCIONAL — PIN de acceso. Si lo defines, el frontend debe mandarlo
# en el header x-rodeo-pass. (El index.html ya manda RODEO2026.)
APP_PASS=RODEO2026
