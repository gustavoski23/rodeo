n't. Willpower is the wrong tool entirely.","words":[{"w":"See,","s":168.785,"e":169.185},{"w":"this","s":169.185,"e":169.425},{"w":"is","s":169.425,"e":169.505},{"w":"where","s":169.505,"e":169.745},{"w":"I","s":169.745,"e":169.905},{"w":"get","s":169.905,"e":170.065},{"w":"opinionated.","s":170.065,"e":170.705},{"w":"Everyone","s":170.87,"e":171.35},{"w":"frames","s":171.35,"e":171.75},{"w":"it","s":171.75,"e":171.91},{"w":"as","s":171.91,"e":172.07},{"w":"a","s":172.07,"e":172.15},{"w":"willpower","s":172.15,"e":172.63},{"w":"problem.","s":172.63,"e":173.35},{"w":"It","s":173.35,"e":173.51},{"w":"isn't.","s":173.51,"e":174.15},{"w":"Willpower","s":174.23,"e":174.71},{"w":"is","s":174.71,"e":174.95},{"w":"the","s":174.95,"e":175.11},{"w":"wrong","s":175.11,"e":175.35},{"w":"tool","s":175.35,"e":175.67},{"w":"entirely.","s":175.67,"e":176.47}]},{"speaker":"Sunnie","start":177.08,"end":181.32,"text":"Careful, you sound like a motivational poster.","words":[{"w":"Careful,","s":177.27,"e":178.07},{"w":"you","s":178.31,"e":178.63},{"w":"sound","s":178.63,"e":179.03},{"w":"like","s":179.03,"e":179.19},{"w":"a","s":179.19,"e":179.35},{"w":"motivational","s":179.35,"e":180.23},{"w":"poster.","s":180.23,"e":181.03}]},{"speaker":"Declan","start":181.62,"end":190.34,"text":"No, hear me out. If night is your only free time, the solution isn't giving it up. It's to carve out time during the day.","words":[{"w":"No,","s":181.75,"e":182.15},{"w":"hear","s":182.15,"e":182.39},{"w":"me","s":182.39,"e":182.63},{"w":"out.","s":182.63,"e":182.87},{"w":"If","s":183.295,"e":183.615},{"w":"night","s":183.615,"e":183.935},{"w":"is","s":183.935,"e":184.175},{"w":"your","s":184.175,"e":184.415},{"w":"only","s":184.415,"e":184.735},{"w":"free","s":184.735,"e":185.135},{"w":"time,","s":185.135,"e":185.695},{"w":"the","s":185.855,"e":186.015},{"w":"solution","s":186.015,"e":186.495},{"w":"isn't","s":186.495,"e":186.895},{"w":"giving","s":186.895,"e":187.135},{"w":"it","s":187.135,"e":187.295},{"w":"up.","s":187.295,"e":187.775},{"w":"It's","s":187.935,"e":188.175},{"w":"to","s":188.175,"e":188.335},{"w":"carve","s":188.335,"e":188.575},{"w":"out","s":188.575,"e":188.815},{"w":"time","s":188.815,"e":189.135},{"w":"during","s":189.135,"e":189.455},{"w":"the","s":189.455,"e":189.615},{"w":"day.","s":189.615,"e":190.095}]},{"speaker":"Sunnie","start":190.64,"end":200,"text":"Carve out time — I love that. Like you're a sculptor, the day is a block of marble, and you chisel out a little space for yourself.","words":[{"w":"Carve","s":190.895,"e":191.295},{"w":"out","s":191.295,"e":191.535},{"w":"time","s":191.535,"e":192.175},{"w":"—","s":192.175,"e":192.215},{"w":"I","s":192.175,"e":192.415},{"w":"love","s":192.415,"e":192.655},{"w":"that.","s":192.655,"e":193.215},{"w":"Like","s":193.455,"e":193.775},{"w":"you're","s":193.775,"e":194.015},{"w":"a","s":194.015,"e":194.175},{"w":"sculptor,","s":194.175,"e":194.975},{"w":"the","s":194.975,"e":195.215},{"w":"day","s":195.215,"e":195.455},{"w":"is","s":195.455,"e":195.695},{"w":"a","s":195.695,"e":195.855},{"w":"block","s":195.855,"e":196.175},{"w":"of","s":196.175,"e":196.335},{"w":"marble,","s":196.335,"e":196.735},{"w":"and","s":197,"e":197.24},{"w":"you","s":197.24,"e":197.48},{"w":"chisel","s":197.48,"e":197.88},{"w":"out","s":197.88,"e":198.12},{"w":"a","s":198.12,"e":198.28},{"w":"little","s":198.28,"e":198.52},{"w":"space","s":198.52,"e":198.84},{"w":"for","s":198.84,"e":199},{"w":"yourself.","s":199,"e":199.64}]},{"speaker":"Declan","start":200.3,"end":210.54,"text":"That's exactly the picture. To carve out time means to deliberately create space in a packed schedule. It doesn't appear on its own — you cut it out.","words":[{"w":"That's","s":200.36,"e":200.84},{"w":"exactly","s":200.84,"e":201.32},{"w":"the","s":201.32,"e":201.56},{"w":"picture.","s":201.56,"e":202.2},{"w":"To","s":202.2,"e":202.44},{"w":"carve","s":202.44,"e":202.76},{"w":"out","s":202.76,"e":203},{"w":"time","s":203,"e":203.32},{"w":"m