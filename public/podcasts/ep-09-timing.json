":"The","s":140.22,"e":140.54},{"w":"target.","s":140.54,"e":141.26},{"w":"Not","s":141.66,"e":141.9},{"w":"laughing","s":141.9,"e":142.3},{"w":"with","s":142.3,"e":142.54},{"w":"you","s":142.54,"e":143.02},{"w":"—","s":143.02,"e":143.1},{"w":"laughing","s":143.1,"e":143.58},{"w":"at","s":143.58,"e":143.74},{"w":"you.","s":143.74,"e":144.195}]},{"speaker":"Zendaya","start":144.495,"end":149.789,"text":"So if a comedian keeps mocking one guy in the audience, that poor guy is the butt of the joke all night.","words":[{"w":"So","s":144.495,"e":144.7},{"w":"if","s":144.7,"e":144.94},{"w":"a","s":144.94,"e":145.1},{"w":"comedian","s":145.1,"e":145.5},{"w":"keeps","s":145.5,"e":145.74},{"w":"mocking","s":145.74,"e":146.22},{"w":"one","s":146.22,"e":146.46},{"w":"guy","s":146.46,"e":146.7},{"w":"in","s":146.7,"e":146.94},{"w":"the","s":146.94,"e":147.02},{"w":"audience,","s":147.02,"e":147.58},{"w":"that","s":147.58,"e":147.74},{"w":"poor","s":147.74,"e":147.98},{"w":"guy","s":147.98,"e":148.22},{"w":"is","s":148.22,"e":148.38},{"w":"the","s":148.38,"e":148.54},{"w":"butt","s":148.54,"e":148.7},{"w":"of","s":148.7,"e":148.86},{"w":"the","s":148.86,"e":149.02},{"w":"joke","s":149.02,"e":149.26},{"w":"all","s":149.26,"e":149.5},{"w":"night.","s":149.5,"e":149.789}]},{"speaker":"Ethan","start":150.089,"end":157.798,"text":"Exactly. And that winter, Eddie was the butt of every joke in the papers. One even called him Mister Magoo on skis.","words":[{"w":"Exactly.","s":150.089,"e":150.94},{"w":"And","s":151.26,"e":151.5},{"w":"that","s":151.5,"e":151.66},{"w":"winter,","s":151.66,"e":152.38},{"w":"Eddie","s":152.38,"e":152.7},{"w":"was","s":152.7,"e":152.86},{"w":"the","s":152.86,"e":153.02},{"w":"butt","s":153.02,"e":153.26},{"w":"of","s":153.26,"e":153.42},{"w":"every","s":153.42,"e":153.66},{"w":"joke","s":153.66,"e":153.98},{"w":"in","s":153.98,"e":154.06},{"w":"the","s":154.06,"e":154.22},{"w":"papers.","s":154.22,"e":154.54},{"w":"One","s":155.075,"e":155.395},{"w":"even","s":155.395,"e":155.715},{"w":"called","s":155.715,"e":155.955},{"w":"him","s":155.955,"e":156.115},{"w":"Mister","s":156.115,"e":156.515},{"w":"Magoo","s":156.515,"e":156.915},{"w":"on","s":156.915,"e":157.075},{"w":"skis.","s":157.075,"e":157.798}]},{"speaker":"Zendaya","start":158.098,"end":165.017,"text":"But here's what gets me: he didn't care. He waved at the cameras, flapped his arms like wings, and grinned through everything.","words":[{"w":"But","s":158.098,"e":158.195},{"w":"here's","s":158.195,"e":158.515},{"w":"what","s":158.515,"e":158.595},{"w":"gets","s":158.595,"e":158.915},{"w":"me:","s":158.915,"e":159.395},{"w":"he","s":159.395,"e":159.475},{"w":"didn't","s":159.475,"e":159.795},{"w":"care.","s":159.795,"e":160.275},{"w":"He","s":160.435,"e":160.675},{"w":"waved","s":160.675,"e":160.995},{"w":"at","s":160.995,"e":161.155},{"w":"the","s":161.155,"e":161.315},{"w":"cameras,","s":161.315,"e":161.955},{"w":"flapped","s":161.955,"e":162.355},{"w":"his","s":162.355,"e":162.515},{"w":"arms","s":162.515,"e":162.835},{"w":"like","s":162.835,"e":163.075},{"w":"wings,","s":163.075,"e":163.635},{"w":"and","s":163.635,"e":163.715},{"w":"grinned","s":163.715,"e":164.195},{"w":"through","s":164.195,"e":164.515},{"w":"everything.","s":164.515,"e":165.017}]},{"speaker":"Ethan","start":165.317,"end":171.308,"text":"Because he wasn't naive. He knew exactly what the crowd wanted, and he delivered it with a huge smile.","words":[{"w":"Because","s":165.317,"e":165.555},{"w":"he","s":165.555,"e":165.795},{"w":"wasn't","s":165.795,"e":166.035},{"w":"naive.","s":166.035,"e":166.755},{"w":"He","s":166.995,"e":167.155},{"w":"knew","s":167.155,"e":167.475},{"w":"exactly","s":167.475,"e":167.875},{"w":"what","s":167.875,"e":168.035},{"w":"the","s":168.035,"e":168.195},{"w":"crowd","s":168.195,"e":168.515},{"w":"wanted,","s":168.515,"e":168.755},{"w":"and","s":169.11,"e":169.35},{"w":"he","s":169.35,"e":169.51},{"w":"delivered","s":169.51,"e":169.91},{"w":"it","s":169.91,"e":170.07},{"w":"with","s":170.07,"e":170.23},{"w":"a","s":170.23,"e":170.39},{"w":"huge","s":170.39,"e":170.71},{"w":"smile.","s":170.71,"e":171.308}]},{"speaker":"Zendaya","start":171.608,"end":179.689,"text":"Even the closing ceremony! The organizing committee's president told the athletes some of them had soared like an eagle. Everyone knew who he meant.","words":[{"w":"Even","s":171.608,"e":171.83},{"w":"the","s":171.83,"e":172.07},{"w":"closing","s":172.07,"e":172.47},{"w":"ceremony!","s":172.47,"e":173.35},{"w":"The","s":173.51,"e":173.75},{"w":"organizing","s":173.75,"e":174.31},{"w":"committee's","s":174.31,"e":174.87},{"w":"president","s":174.87,"e":175.27},{"w":"told","s":175.27,"e":175.59},{"w":"the","s":175.59,"e":175.75},{"w":"athletes","s":175.75,"e":176.15},{"w":"some","s":176.15,"e":176.39},{"w":"of","s":176.39,"e":176.47},{"w":"them","s":176.47,"e":176.63},{"w":"had","s":176.63,"e":176.87},{"w":"soared","s":176.87,"e":177.27},{"w":"like","s":177.27,"e":177.43},{"w":"an","s":177.43,"e":177.59},{"w":"eagle.","s":177.59,"e":178.23},{"w":"Everyone","s":178.31,"e":178.71},{"w":"knew","s":178.71,"e":179.03},{"w":"who","s":179.03,"e":179.19},{"w":"he","s":179.19,"e":179.35},{"w":"meant.","s":179.35,"e":179.689}]},{"speaker":"Ethan","start":179.989,"end":184.865,"text":"Meanwhile, the gold medalist in ski jumping that year — quick, name him.","words":[{"w":"Meanwhile,","s":179.989,"e":180.71},{"w":"the","s":180.95,"e":181.11},{"w":"gold","s":181.11,"e":181.43},{"w":"medalist","s":181.43,"e":181.91},{"w":"in","s":181.91,"e":182.07},{"w":"ski","s":182.07,"e":182.31},{"w":"jumping","s":182.31,"e":182.63},{"w":"that","s":182.63,"e":182.87},{"w":"year","s":182.87,"e":183.43},{"w":"—","s":183.43,"e":183.51},{"w":"quick,","s":183.51,"e":184.15},{"w":"name","s":184.15,"e":184.47},{"w":"him.","s":184.47,"e":184.63}]},{"speaker":"Zendaya","start":185.165,"end":189.948,"text":"I... genuinely cannot. And that, Ethan, is my entire point.","words":[{"w":"I...","s":185.165,"