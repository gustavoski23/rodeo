":"clean","s":133.555,"e":133.875},{"w":"off","s":133.875,"e":134.115},{"w":"the","s":134.115,"e":134.195},{"w":"course,","s":134.195,"e":134.835},{"w":"and","s":134.915,"e":135.075},{"w":"the","s":135.075,"e":135.235},{"w":"camera","s":135.235,"e":135.555},{"w":"catches","s":135.555,"e":135.955},{"w":"that","s":135.955,"e":136.195},{"w":"too","s":136.195,"e":136.835},{"w":"—","s":136.835,"e":136.875},{"w":"the","s":136.835,"e":136.995},{"w":"whole","s":136.995,"e":137.235},{"w":"sequence.","s":137.235,"e":137.955}]},{"speaker":"Alice","start":137.955,"end":145.075,"text":"So the photo is actually three photos, almost a film strip. Grab, scream, block. And it went around the world.","words":[{"w":"So","s":137.955,"e":138.195},{"w":"the","s":138.195,"e":138.435},{"w":"photo","s":138.435,"e":138.835},{"w":"is","s":138.835,"e":139.075},{"w":"actually","s":139.075,"e":139.475},{"w":"three","s":139.475,"e":139.875},{"w":"photos,","s":139.875,"e":140.595},{"w":"almost","s":140.675,"e":141.075},{"w":"a","s":141.075,"e":141.235},{"w":"film","s":141.235,"e":141.555},{"w":"strip.","s":141.555,"e":142.195},{"w":"Grab,","s":142.275,"e":142.835},{"w":"scream,","s":142.835,"e":143.315},{"w":"block.","s":143.315,"e":143.955},{"w":"And","s":143.955,"e":144.115},{"w":"it","s":144.115,"e":144.275},{"w":"went","s":144.275,"e":144.515},{"w":"around","s":144.515,"e":144.755},{"w":"the","s":144.755,"e":144.915},{"w":"world.","s":144.915,"e":145.075}]},{"speaker":"David","start":145.61,"end":152.33,"text":"Front pages everywhere. And suddenly the question wasn't why is she running — it was why on earth is he attacking her?","words":[{"w":"Front","s":145.61,"e":145.93},{"w":"pages","s":145.93,"e":146.41},{"w":"everywhere.","s":146.41,"e":147.21},{"w":"And","s":147.37,"e":147.53},{"w":"suddenly","s":147.53,"e":147.93},{"w":"the","s":147.93,"e":148.17},{"w":"question","s":148.17,"e":148.57},{"w":"wasn't","s":148.57,"e":148.97},{"w":"why","s":148.97,"e":149.21},{"w":"is","s":149.21,"e":149.37},{"w":"she","s":149.37,"e":149.53},{"w":"running","s":149.53,"e":150.17},{"w":"—","s":150.17,"e":150.25},{"w":"it","s":150.25,"e":150.41},{"w":"was","s":150.41,"e":150.57},{"w":"why","s":150.57,"e":150.81},{"w":"on","s":150.81,"e":150.97},{"w":"earth","s":150.97,"e":151.21},{"w":"is","s":151.21,"e":151.37},{"w":"he","s":151.37,"e":151.53},{"w":"attacking","s":151.53,"e":151.93},{"w":"her?","s":151.93,"e":152.33}]},{"speaker":"Alice","start":152.33,"end":158.25,"text":"Which is the moment a photo becomes a mirror. People saw it and got uncomfortable with rules they'd never questioned.","words":[{"w":"Which","s":152.33,"e":152.49},{"w":"is","s":152.49,"e":152.65},{"w":"the","s":152.65,"e":152.81},{"w":"moment","s":152.81,"e":153.05},{"w":"a","s":153.05,"e":153.21},{"w":"photo","s":153.21,"e":153.61},{"w":"becomes","s":153.61,"e":154.01},{"w":"a","s":154.01,"e":154.17},{"w":"mirror.","s":154.17,"e":154.73},{"w":"People","s":154.89,"e":155.21},{"w":"saw","s":155.21,"e":155.53},{"w":"it","s":155.53,"e":155.69},{"w":"and","s":155.69,"e":155.93},{"w":"got","s":155.93,"e":156.17},{"w":"uncomfortable","s":156.17,"e":156.81},{"w":"with","s":156.81,"e":156.97},{"w":"rules","s":156.97,"e":157.29},{"w":"they'd","s":157.29,"e":157.61},{"w":"never","s":157.61,"e":157.85},{"w":"questioned.","s":157.85,"e":158.25}]},{"speaker":"David","start":158.655,"end":168.415,"text":"She finished, by the way. Four hours, twenty minutes, half frozen and furious. She said she started as a girl and finished as a woman with a mission.","words":[{"w":"She","s":158.655,"e":159.055},{"w":"finished,","s":159.055,"e":159.535},{"w":"by","s":159.535,"e":159.695},{"w":"the","s":159.695,"e":159.855},{"w":"way.","s":159.855,"e":160.335},{"w":"Four","s":160.575,"e":160.895},{"w":"hours,","s":160.895,"e":161.455},{"w":"twenty","s":161.455,"e":161.855},{"w":"minutes,","s":161.855,"e":162.495},{"w":"half","s":162.575,"e":162.895},{"w":"frozen","s":162.895,"e":163.295},{"w":"and","s":163.295,"e":163.535},{"w":"furious.","s":163.535,"e":164.335},{"w":"She","s":164.495,"e":164.735},{"w":"said","s":164.735,"e":164.975},{"w":"she","s":164.975,"e":165.215},{"w":"started","s":165.215,"e":165.535},{"w":"as","s":165.535,"e":165.695},{"w":"a","s":165.695,"e":165.855},{"w":"girl","s":165.855,"e":166.175},{"w":"and","s":166.175,"e":166.575},{"w":"finished","s":166.575,"e":166.975},{"w":"as","s":166.975,"e":167.135},{"w":"a","s":167.135,"e":167.215},{"w":"woman","s":167.215,"e":167.535},{"w":"with","s":167.535,"e":167.775},{"w":"a","s":167.775,"e":167.935},{"w":"mission.","s":167.935,"e":168.415}]},{"speaker":"Alice","start":168.415,"end":174.175,"text":"And the official response? Let me guess. They thanked her for her courage and immediately changed the rules.","words":[{"w":"And","s":168.415,"e":168.495},{"w":"the","s":168.495,"e":168.735},{"w":"official","s":168.735,"e":169.135},{"w":"response?","s":169.135,"e":169.855},{"w":"Let","s":169.935,"e":170.255},{"w":"me","s":170.255,"e":170.415},{"w":"guess.","s":170.415,"e":170.975},{"w":"They","s":171.055,"e":171.215},{"w":"thanked","s":171.215,"e":171.615},{"w":"her","s":171.615,"e":171.695},{"w":"for","s":171.695,"e":171.855},{"w":"her","s":171.855,"e":172.095},{"w":"courage","s":172.095,"e":172.495},{"w":"and","s":172.495,"e":172.815},{"w":"immediately","s":172.815,"e":173.375},{"w":"changed","s":173.375,"e":173.775},{"w":"the","s":173.775,"e":173.935},{"w":"rules.","s":173.935,"e":174.175}]},{"speaker":"David","start":174.71,"end":183.19,"text":"They disqualified her. And women stayed banned — Boston didn't officially admit them until 1972, five whole years later.","words":[{"w":"They","s":174.71,"e":175.11},{"w":"disqualified","s":175.11,"e":175.75},{"w":"her.","s":175.75,"e":176.39},{"w":"And","s":176.39,"e":176.55},{"w":"women","s":176.55,"e":176.87},{"w":"stayed","s":176.87,"e":177.27},{"w":"banned","s":177.27,"e":177.67},{"w":"—","s":177.67,"e":177.70999999999998},{"w":"Boston","s":177.67,"e":178.39},{"w":"didn't","s":178.39,"