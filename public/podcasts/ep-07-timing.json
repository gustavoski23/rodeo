sychologists have studied it seriously.","words":[{"w":"It","s":78.985,"e":79.225},{"w":"can.","s":79.225,"e":79.465},{"w":"It's","s":79.83,"e":80.23},{"w":"called","s":80.23,"e":80.39},{"w":"the","s":80.39,"e":80.63},{"w":"doorway","s":80.63,"e":81.11},{"w":"effect,","s":81.11,"e":81.59},{"w":"and","s":81.59,"e":81.91},{"w":"psychologists","s":81.91,"e":82.63},{"w":"have","s":82.63,"e":82.95},{"w":"studied","s":82.95,"e":83.27},{"w":"it","s":83.27,"e":83.43},{"w":"seriously.","s":83.43,"e":84.23}]},{"speaker":"David","start":84.63,"end":87.27,"text":"The doorway effect. You're joking.","words":[{"w":"The","s":84.63,"e":84.87},{"w":"doorway","s":84.87,"e":85.35},{"w":"effect.","s":85.35,"e":86.07},{"w":"You're","s":86.07,"e":86.55},{"w":"joking.","s":86.55,"e":87.27}]},{"speaker":"Alice","start":87.27,"end":96.535,"text":"Not joking. Your brain treats each room like a separate file. When you cross a doorway, it quietly closes the old file and opens a new one.","words":[{"w":"Not","s":87.27,"e":87.59},{"w":"joking.","s":87.59,"e":88.31},{"w":"Your","s":88.47,"e":88.79},{"w":"brain","s":88.79,"e":89.11},{"w":"treats","s":89.11,"e":89.43},{"w":"each","s":89.43,"e":89.75},{"w":"room","s":89.75,"e":90.07},{"w":"like","s":90.07,"e":90.31},{"w":"a","s":90.31,"e":90.47},{"w":"separate","s":90.47,"e":90.79},{"w":"file.","s":90.79,"e":91.43},{"w":"When","s":91.59,"e":91.83},{"w":"you","s":91.83,"e":91.99},{"w":"cross","s":91.99,"e":92.23},{"w":"a","s":92.23,"e":92.39},{"w":"doorway,","s":92.39,"e":92.79},{"w":"it","s":93.015,"e":93.255},{"w":"quietly","s":93.255,"e":93.735},{"w":"closes","s":93.735,"e":94.215},{"w":"the","s":94.215,"e":94.375},{"w":"old","s":94.375,"e":94.615},{"w":"file","s":94.615,"e":95.015},{"w":"and","s":95.015,"e":95.335},{"w":"opens","s":95.335,"e":95.735},{"w":"a","s":95.735,"e":95.895},{"w":"new","s":95.895,"e":96.055},{"w":"one.","s":96.055,"e":96.535}]},{"speaker":"David","start":96.695,"end":106.615,"text":"So the door wiped my memory. The door, Alice. That sounds like an excuse, not an explanation. Next you'll tell me the stairs stole my keys.","words":[{"w":"So","s":96.695,"e":97.095},{"w":"the","s":97.095,"e":97.335},{"w":"door","s":97.335,"e":97.575},{"w":"wiped","s":97.575,"e":97.975},{"w":"my","s":97.975,"e":98.215},{"w":"memory.","s":98.215,"e":98.935},{"w":"The","s":99.175,"e":99.335},{"w":"door,","s":99.335,"e":99.895},{"w":"Alice.","s":99.895,"e":100.615},{"w":"That","s":100.775,"e":101.015},{"w":"sounds","s":101.015,"e":101.415},{"w":"like","s":101.415,"e":101.655},{"w":"an","s":101.655,"e":101.815},{"w":"excuse,","s":101.815,"e":102.535},{"w":"not","s":102.535,"e":102.775},{"w":"an","s":102.775,"e":103.015},{"w":"explanation.","s":103.015,"e":103.815},{"w":"Next","s":104.215,"e":104.535},{"w":"you'll","s":104.535,"e":104.855},{"w":"tell","s":104.855,"e":104.935},{"w":"me","s":104.935,"e":105.095},{"w":"the","s":105.095,"e":105.335},{"w":"stairs","s":105.335,"e":105.655},{"w":"stole","s":105.655,"e":106.055},{"w":"my","s":106.055,"e":106.295},{"w":"keys.","s":106.295,"e":106.615}]},{"speaker":"Alice","start":107.35,"end":117.99,"text":"It's not an excuse, it's an event boundary. Crossing the threshold tells your brain: new scene, new rules. The shopping list from the old scene gets archived.","words":[{"w":"It's","s":107.35,"e":107.75},{"w":"not","s":107.75,"e":107.91},{"w":"an","s":107.91,"e":108.07},{"w":"excuse,","s":108.07,"e":108.79},{"w":"it's","s":108.87,"e":109.03},{"w":"an","s":109.03,"e":109.19},{"w":"event","s":109.19,"e":109.51},{"w":"boundary.","s":109.51,"e":110.31},{"w":"Crossing","s":110.47,"e":110.79},{"w":"the","s":110.79,"e":111.03},{"w":"threshold","s":111.03,"e":111.51},{"w":"tells","s":111.51,"e":111.91},{"w":"your","s":111.91,"e":112.15},{"w":"brain:","s":112.15,"e":112.71},{"w":"new","s":112.87,"e":113.19},{"w":"scene,","s":113.19,"e":113.83},{"w":"new","s":113.91,"e":114.23},{"w":"rules.","s":114.23,"e":114.87},{"w":"The","s":114.95,"e":115.27},{"w":"shopping","s":115.27,"