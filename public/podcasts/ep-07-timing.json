105},{"w":"second","s":132.105,"e":132.425},{"w":"expression,","s":132.425,"e":133.145},{"w":"and","s":133.145,"e":133.465},{"w":"honestly,","s":133.465,"e":134.185},{"w":"it's","s":134.185,"e":134.425},{"w":"perfect","s":134.425,"e":134.745},{"w":"here.","s":134.745,"e":134.985}]},{"speaker":"David","start":135.6,"end":138.96,"text":"Did I? I wasn't even trying to be educational.","words":[{"w":"Did","s":135.6,"e":135.92},{"w":"I?","s":135.92,"e":136.48},{"w":"I","s":136.56,"e":136.8},{"w":"wasn't","s":136.8,"e":137.12},{"w":"even","s":137.12,"e":137.44},{"w":"trying","s":137.44,"e":137.76},{"w":"to","s":137.76,"e":137.84},{"w":"be","s":137.84,"e":138},{"w":"educational.","s":138,"e":138.96}]},{"speaker":"Alice","start":138.96,"end":147.52,"text":"When something slips your mind, you simply forget it, usually something you meant to do. It slides away quietly, like a fish through your fingers.","words":[{"w":"When","s":138.96,"e":139.2},{"w":"something","s":139.2,"e":139.6},{"w":"slips","s":139.6,"e":140},{"w":"your","s":140,"e":140.24},{"w":"mind,","s":140.24,"e":140.8},{"w":"you","s":140.8,"e":140.96},{"w":"simply","s":140.96,"e":141.36},{"w":"forget","s":141.36,"e":141.68},{"w":"it,","s":141.68,"e":142.24},{"w":"usually","s":142.24,"e":142.64},{"w":"something","s":142.64,"e":143.04},{"w":"you","s":143.04,"e":143.28},{"w":"meant","s":143.28,"e":143.52},{"w":"to","s":143.52,"e":143.6},{"w":"do.","s":143.6,"e":144.08},{"w":"It","s":144.32,"e":144.56},{"w":"slides","s":144.56,"e":144.96},{"w":"away","s":144.96,"e":145.28},{"w":"quietly,","s":145.28,"e":145.92},{"w":"like","s":145.92,"e":146.32},{"w":"a","s":146.32,"e":146.48},{"w":"fish","s":146.48,"e":146.72},{"w":"through","s":146.72,"e":147.04},{"w":"your","s":147.04,"e":147.2},{"w":"fingers.","s":147.2,"e":147.52}]},{"speaker":"David","start":148.225,"end":156.225,"text":"So a birthday can slip your mind, an appointment can slip your mind. It's gentle forgetting, not dramatic amnesia.","words":[{"w":"So","s":148.225,"e":148.545},{"w":"a","s":148.545,"e":148.785},{"w":"birthday","s":148.785,"e":149.185},{"w":"can","s":149.185,"e":149.425},{"w":"slip","s":149.425,"e":149.745},{"w":"your","s":149.745,"e":149.985},{"w":"mind,","s":149.985,"e":150.465},{"w":"an","s":150.705,"e":150.865},{"w":"appointment","s":150.865,"e":151.425},{"w":"can","s":151.425,"e":151.745},{"w":"slip","s":151.745,"e":151.985},{"w":"your","s":151.985,"e":152.225},{"w":"mind.","s":152.225,"e":152.785},{"w":"It's","s":152.865,"e":153.185},{"w":"gentle","s":153.185,"e":153.585},{"w":"forgetting,","s":153.585,"e":154.465},{"w":"not","s":154.545,"e":154.705},{"w":"dramatic","s":154.705,"e":155.185},{"w":"amnesia.","s":155.185,"e":156.225}]},{"speaker":"Alice","start":156.225,"end":163.505,"text":"Exactly. And notice the grammar: the forgotten thing is the subject. It slipped my mind, not I slipped.","words":[{"w":"Exactly.","s":156.225,"e":157.025},{"w":"And","s":157.185,"e":157.345},{"w":"notice","s":157.345,"e":157.825},{"w":"the","s":157.825,"e":157.985},{"w":"grammar:","s":157.985,"e":158.705},{"w":"the","s":158.705,"e":158.945},{"w":"forgotten","s":158.945,"e":159.425},{"w":"thing","s":159.425,"e":159.745},{"w":"is","s":159.745,"e":159.985},{"w":"the","s":159.985,"e":160.225},{"w":"subject.","s":160.225,"e":160.865},{"w":"It","s":161.025,"e":161.185},{"w":"slipped","s":161.185,"e":161.585},{"w":"my","s":161.585,"e":161.905},{"w":"mind,","s":161.905,"e":162.545},{"w":"not","s":162.625,"e":162.865},{"w":"I","s":162.865,"e":163.105},{"w":"slipped.","s":163.105,"e":163.505}]},{"speaker":"David","start":164.26,"end":172.1,"text":"Good, because I do enough slipping in real life. Now explain the sofa magic. Why did everything come back when you sat down?","words":[{"w":"Good,","s":164.26,"e":164.82},{"w":"because","s":164.82,"e":165.06},{"w":"I","s":165.06,"e":165.3},{"w":"do","s":165.3,"e":165.46},{"w":"enough","s":165.46,"e":165.78},{"w":"slipping","s":165.78,"e":166.18},{"w":"in","s":166.18,"e":166.42},{"w":"real","s":166.42,"e":166.74},{"w":"life.","s":166.74,"e":167.22},{"w":"Now","s":167.46,"e":167.7},{"w":"explain","s":167.7,"e":168.18},{"w":"the","s":168.18,"e":168.42},{"w":"sofa","s":168.42,"e":168.82},{"w":"magic.","s":168.82,"e":169.54},{"w":"Why","s":169.54,"e":169.78},{"w":"did","s":169.78,"e":170.02},{"w":"everything","s":170.02,"e":170.42},{"w":"come","s":170.42,"e":170.66},{"w":"back","s":170.66,"e":170.9},{"w":"when","s":170.9,"e":171.14},{"w":"you","s":171.14,"e":171.3},{"w":"sat","s":171.3,"e":171.62},{"w":"down?","s":171.62,"e":172.1}]},{"speaker":"Alice","start":172.1,"end":181.155,"text":"That's the practical trick. Returning to the room where you had the thought reopens the file. Same walls, same chair, same mental scene.","words":[{"w":"That's","s":172.1,"e":172.66},{"w":"the","s":172.66,"e":172.82},{"w":"practical","s":172.82,"e":173.3},{"w":"trick.","s":173.3,"e":173.86},{"w":"Returning","s":174.02,"e":174.5},{"w":"to","s":174.5,"e":174.66},{"w":"the","s":174.66,"e":174.74},{"w":"room","s":174.74,"e":174.98},{"w":"where","s":174.98,"e":175.22},{"w":"you","s":175.22,"e":175.38},{"w":"had","s":175.38,"e":175.54},{"w":"the","s":175.54,"e":175.7},{"w":"thought","s":175.7,"e":176.02},{"w":"reopens","s":176.02,"e":176.66},{"w":"the","s":176.66,"e":176.82},{"w":"file.","s":176.82,"e":177.14},{"w":"Same","s":177.555,"e":177.955},{"w":"walls,","s":177.955,"e":178.675},{"w":"same","s":178.755,"e":179.075},{"w":"chair,","s":179.075,"e":179.715},{"w":"same","s":179.795,"e":180.035},{"w":"mental","s":180.035,"e":180.435},{"w":"scene.","s":180.435,"e":181.155}]},{"speaker":"David","start":181.475,"end":187.955,"text":"So the cure for the doorway is more doorways. Walk back through, and the brain goes, ah yes, the scissors.","words":[{"w":"So","s":181.475,"e":181.635},{"w":"the","s":181.635,"e":181.795},{"w":"cure","s":181.795,"e":182.115},{"w":"for","s":182.115,"e":182.275},{"w":"the","s":182.275,"e":182.355},{"w":"doorway","s":182.355,"e":182.755},{"w":"is","s":182.755,"e":182.995},{"w":"more","s":182.995,"e":183.235},{"w":"doorways.","s":183.235,"e":184.035},{"w":"Walk","s":184.115,"e":184.355},{"w":"back","s":184.355,"e":184.675},{"w":"through,","s":184.675,"e":185.075},{"w":"and","s":185.075,"e":185.315},{"w":"the","s":185.315,"e":185.475},{"w":"brain","s":185.475,"e":185.795},{"w":"goes,","s":185.795,"e":186.275},{"w":"ah","s":186.275,"e":186.595},{"w":"yes,","s":186.595,"e":187.075},{"w":"the","s":187.075,"e":187.315},{"w":"scissors.","s":187.315,"e":187.955}]},{"speaker":"Alice","start":188.035,"end":197.29,"text":"Basically, yes. Context is the key that unlocks the memory. Researchers even tested this with virtual rooms on a screen, and people still forgot.","words":[{"w":"Basically,","s":188.035,"e":188.675},{"w":"yes.","s":188.675,"e":189.235},{"w":"Context","s":189.475,"e":189.955},{"w":"is","s":189.955,"e":190.195},{"w":"the","s":190.195,"e":190.355},{"w":"key","s":190.355,"e":190.595},{"w":"that","s":190.595,"e":190.835},{"w":"unlocks","s":190.835,"e":191.235},{"w":"the","s":191.235,"e":191.395},{"w":"memory.","s":191.395,"e":191.715},{"w":"Researchers","s":192.17,"e":192.89},{"w":"even","s":192.89,"e":193.13},{"w":"tested","s":193.13,"e":193.53},{"w":"this","s":193.53,"e":193.77},{"w":"with","s":193.77,"e":193.93},{"w":"virtual","s":193.93,"e":194.41},{"w":"rooms","s":194.41,"e":194.73},{"w":"on","s":194.73,"e":194.97},{"w":"a","s":194.97,"e":195.13},{"w":"screen,","s":195.13,"e":195.69},{"w":"and","s":195.77,"e":195.93},{"w":"people","s":195.93,"e":196.25},{"w":"still","s":196.25,"e":196.57},{"w":"forgot.","s":196.57,"e":197.29}]},{"speaker":"David","start":197.69,"end":204.17,"text":"Even virtual doorways? That's disturbing. My brain is losing files over doors that don't physically exist.","words":[{"w":"Even","s":197.69,"e":197.93},{"w":"virtual","s":197.93,"e":198.49},{"w":"doorways?","s":198.49,"e":199.29},{"w":"That's","s":199.29,"e":199.69},{"w":"disturbing.","s":199.69,"e":200.49},{"w":"My","s":200.57,"e":200.89},{"w":"brain","s":200.89,"e":201.13},{"w":"is","s":201.13,"e":201.37},{"w":"losing","s":201.37,"e":201.69},{"w":"files","s":201.69,"e":202.09},{"w":"over","s":202.09,"e":202.41},{"w":"doors","s":202.41,"e":202.89},{"w":"that","s":202.89,"e":203.05},{"w":"don't","s":203.05,"e":203.37},{"w":"physically","s":203.37,"e":203.85},{"w":"exist.","s":203.85,"e":204.17}]},{"speaker":"Alice","start":204.445,"end":212.765,"text":"Which proves you're not careless. It's simply how memory organizes experience, in scenes and chapters, like a very strict librarian.","words":[{"w":"Which","s":204.445,"e":204.765},{"w":"proves","s":204.765,"e":205.085},{"w":"you're","s":205.085,"e":205.405},{"w":"not","s":205.405,"e":205.565},{"w":"careless.","s":205.565,"e":206.205},{"w":"It's","s":206.205,"e":206.605},{"w":"simply","s":206.605,"e":206.845},{"w":"how","s":206.845,"e":207.085},{"w":"memory","s":207.085,"e":207.485},{"w":"organizes","s":207.485,"e":208.205},{"w":"experience,","s":208.205,"e":209.005},{"w":"in","s":209.005,"e":209.325},{"w":"scenes","s":209.325,"e":209.725},{"w":"and","s":209.725,"e":209.965},{"w":"chapters,","s":209.965,"e":210.605},{"w":"like","s":210.605,"e":210.925},{"w":"a","s":210.925,"e":211.165},{"w":"very","s":211.165,"e":211.405},{"w":"strict","s":211.405,"e":211.725},{"w":"librarian.","s":211.725,"e":212.765}]},{"speaker":"David","start":213.245,"end":220.24,"text":"Fine, I'll grant the door partial blame. But sometimes I reach the kitchen and the word I need is right there, almost...","words":[{"w":"Fine,","s":213.245,"e":213.725},{"w":"I'll","s":213.725,"e":214.045},{"w":"grant","s":214.045,"e":214.285},{"w":"the","s":214.285,"e":214.445},{"w":"door","s":214.445,"e":214.685},{"w":"partial","s":214.685,"e":215.165},{"w":"blame.","s":215.165,"e":215.805},{"w":"But","s":215.965,"e":216.125},{"w":"sometimes","s":216.125,"e":216.605},{"w":"I","s":216.605,"e":216.845},{"w":"reach","s":216.845,"e":217.085},{"w":"the","s":217.085,"e":217.245},{"w":"kit