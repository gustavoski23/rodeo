,"e":14.895},{"w":"or","s":14.895,"e":15.135},{"w":"completely,","s":15.135,"e":15.775},{"w":"gloriously","s":15.775,"e":16.415},{"w":"ridiculous.","s":16.415,"e":17.295},{"w":"Which","s":17.295,"e":17.615},{"w":"one","s":17.615,"e":17.775},{"w":"is","s":17.775,"e":17.935},{"w":"it?","s":17.935,"e":18.415}]},{"speaker":"Alice","start":18.575,"end":28.18,"text":"Nineteen thirty-two. Western Australia. The Australian army deploys soldiers with machine guns against an invading force of twenty thousand... and I want you to sit with this... emus.","words":[{"w":"Nineteen","s":18.575,"e":19.055},{"w":"thirty-two.","s":19.055,"e":20.015},{"w":"Western","s":20.015,"e":20.495},{"w":"Australia.","s":20.495,"e":21.295},{"w":"The","s":21.295,"e":21.455},{"w":"Australian","s":21.455,"e":22.015},{"w":"army","s":22.015,"e":22.335},{"w":"deploys","s":22.335,"e":22.815},{"w":"soldiers","s":22.815,"e":23.295},{"w":"with","s":23.295,"e":23.535},{"w":"machine","s":23.535,"e":23.855},{"w":"guns","s":23.855,"e":24.175},{"w":"against","s":24.175,"e":24.495},{"w":"an","s":24.495,"e":24.735},{"w":"invading","s":24.735,"e":25.135},{"w":"force","s":25.135,"e":25.455},{"w":"of","s":25.455,"e":25.695},{"w":"twenty","s":25.695,"e":26.015},{"w":"thousand...","s":26.015,"e":26.335},{"w":"and","s":26.58,"e":26.82},{"w":"I","s":26.82,"e":26.98},{"w":"want","s":26.98,"e":27.14},{"w":"you","s":27.14,"e":27.38},{"w":"to","s":27.38,"e":27.46},{"w":"sit","s":27.46,"e":27.7},{"w":"with","s":27.7,"e":27.86},{"w":"this...","s":27.86,"e":28.18},{"w":"emus.","s":28.18,"e":28.22}]},{"speaker":"David","start":30.18,"end":39.86,"text":"Emus. The birds. You're telling me a professional military force pointed actual machine guns at giant flightless birds, and somehow this counts as a war? I refuse to believe it.","words":[{"w":"Emus.","s":30.18,"e":30.22},{"w":"The","s":30.18,"e":30.42},{"w":"birds.","s":30.42,"e":31.06},{"w":"You're","s":31.14,"e":31.38},{"w":"telling","s":31.38,"e":31.7},{"w":"me","s":31.7,"e":31.86},{"w":"a","s":31.86,"e":32.02},{"w":"professional","s":32.02,"e":32.58},{"w":"military","s":32.58,"e":33.14},{"w":"force","s":33.14,"e":33.46},{"w":"pointed","s":33.46,"e":33.86},{"w":"actual","s":33.86,"e":34.34},{"w":"machine","s":34.34,"e":34.74},{"w":"guns","s":34.74,"e":35.06},{"w":"at","s":35.06,"e":35.22},{"w":"giant","s":35.22,"e":35.54},{"w":"flightless","s":35.54,"e":36.18},{"w":"birds,","s":36.18,"e":36.82},{"w":"and","s":36.82,"e":36.98},{"w":"somehow","s":36.98,"e":37.3},{"w":"this","s":37.3,"e":37.62},{"w":"counts","s":37.62,"e":37.86},{"w":"as","s":37.86,"e":38.02},{"w":"a","s":38.02,"e":38.18},{"w":"war?","s":38.18,"e":38.66},{"w":"I","s":38.74,"e":38.9},{"w":"refuse","s":38.9,"e":39.3},{"w":"to","s":39.3,"e":39.46},{"w":"believe","s":39.46,"e":39.7},{"w":"it.","s":39.7,"e":39.86}]},{"speaker":"Alice","start":40.515,"end":50.755,"text":"Believe it. And here's the part nobody expects: the birds won. Decisively. The army retreated twice, and the whole thing became an international embarrassment for the government.","words":[{"w":"Believe","s":40.515,"e":40.915},{"w":"it.","s":40.915,"e":41.395},{"w":"And","s":41.395,"e":41.555},{"w":"here's","s":41.555,"e":41.875},{"w":"the","s":41.875,"e":42.035},{"w":"part","s":42.035,"e":42.195},{"w":"nobody","s":42.195,"e":42.675},{"w":"expects:","s":42.675,"e":43.475},{"w":"the","s":43.475,"e":43.635},{"w":"birds","s":43.635,"e":43.955},{"w":"won.","s":43.955,"e":44.515},{"w":"Decisively.","s":44.515,"e":45.555},{"w":"The","s":45.635,"e":45.875},{"w":"army","s":45.875,"e":46.195},{"w":"retreated","s":46.195,"e":46.755},{"w":"twice,","s":46.755,"e":47.315},{"w":"and","s":47.315,"e":47.395},{"w":"the","s":47.395,"e":47.555},{"w":"whole","s":47.555,"e":47.795},{"w":"thing","s":47.795,"e":48.035},{"w":"became","s":48.035,"e":48.355},{"w":"an","s":48.355,"e":48.595},{"w":"international","s":48.595,"e":49.235},{"w":"embarrassment","s":49.235,"e":49.875},{"w":"for","s":49.875,"e":50.035},{"w":"the","s":50.035,"e":50.195},{"w":"government.","s":50.195,"e":50.755}]},{"speaker":"David","start":51.155,"end":60.8,"text":"Okay, hold on, back up, because I have so many questions. Who looked at a bird problem and thought, you know what this needs? Artillery. Who does that?","words":[{"w":"Okay,","s":51.155,"e":52.515},{"w":"hold","s":52.755,"e":52.995},{"w":"on,","s":52.995,"e":53.315},{"w":"back","s":53.315,"e":53.555},{"w":"up,","s":53.555,"e":53.715},{"w":"because","s":53.715,"e":54.115},{"w":"I","s":54.115,"e":54.275},{"w":"have","s":54.275,"e":54.515},{"w":"so","s":54.515,"e":54.675},{"w":"many","s":54.675,"e":54.995},{"w":"questions.","s":54.995,"e":55.315},{"w":"Who","s":55.76,"e":56.08},{"w":"looked","s":56.08,"e":56.32},{"w":"at","s":56.32,"e":56.4},{"w":"a","s":56.4,"e":56.56},{"w":"bird","s":56.56,"e":56.8},{"w":"problem","s":56.8,"e":57.2},{"w":"and","s":57.2,"e":57.36},{"w":"thought,","s":57.36,"e":57.76},{"w":"you","s":57.76,"e":57.92},{"w":"know","s":57.92,"e":58.08},{"w":"what","s":58.08,"e":58.24},{"w":"this","s":58.24,"e":58.4},{"w":"needs?","s":58.4,"e":58.96},{"w":"Artillery.","s":58.96,"e":59.84},{"w":"Who","s":59.84,"e":60.08},{"w":"does","s":60.08,"e":60.32},{"w":"that?","s":60.32,"e":60.8}]},{"speaker":"Alice","start":61.04,"end":69.6,"text":"Desperate people, honestly. The farmers out there were veterans of the First World War, and the Great Depression had already crushed them before a single bird showed up.","words":[{"w":"Desperate","s":61.04,"e":61.6},{"w":"people,","s":61.6,"e":62},{"w":"honestly.","s":62,"e":62.8},{"w":"The","s":62.8,"e":63.04},{"w":"farmers","s":63.04,"e":63.44},{"w":"out","s":63.44,"e":63.6},{"w":"there","s":63.6,"e":63.84},{"w":"were","s":63.84,"e":64.08},{"w":"veterans","s":64.08,"e":64.48},{"w":"of","s":64.48,"e":64.72},{"w":"the","s":64.72,"e":64.8},{"w":"First","s":64.8,"e":65.04},{"w":"World","s":65.04,"e":65.36},{"w":"War,","s":65.36,"e":65.84},{"w":"and","s":65.84,"e":66.08},{"w":"the","s":66.08,"e":66.24},{"w":"Great","s":66.24,"e":66.48},{"w":"Depression","s":66.48,"e":66.96},{"w":"had","s":66.96,"e":67.2},{"w":"already","s":67.2,"e":67.6},{"w":"crushed","s":67.6,"e":67.92},{"w":"them","s":67.92,"e":68.08},{"w":"before","s":68.08,"e":68.4},{"w":"a","s":68.4,"e":68.56},{"w":"single","s":68.56,"e":68.88},{"w":"bird","s":68.88,"e":69.2},{"w":"showed","s":69.2,"e":69.44},{"w":"up.","s":69.44,"e":69.6}]},{"speaker":"David","start":70.285,"end":79.645,"text":"Oh, so there's a real human story hiding under the ridiculous one. That's sneaky, Alice. Now I feel bad for laughing at these poor guys and their bird apocalypse.","words":[{"w":"Oh,","s":70.285,"e":70.845},{"w":"so","s":70.845,"e":71.005},{"w":"there's","s":71.005,"e":71.325},{"w":"a","s":71.325,"e":71.405},{"w":"real","s":71.405,"e":71.645},{"w":"human","s":71.645,"e":72.045},{"w":"story","s":72.045,"e":72.365},{"w":"hiding","s":72.365,"e":72.765},{"w":"under","s":72.765,"e":73.005},{"w":"the","s":73.005,"e":73.165},{"w":"ridiculous","s":73.165,"e":73.725},{"w":"one.","s":73.725,"e":74.285},{"w":"That's","s":74.285,"e":74.605},{"w":"sneaky,","s":74.605,"e":75.005},{"w":"Alice.","s":75.005,"e":75.725},{"w":"Now","s":75.725,"e":75.965},{"w":"I","s":75.965,"e":76.125},{"w":"feel","s":76.125,"e":76.365},{"w":"bad","s":76.365,"e":76.685},{"w":"for","s":76.685,"e":76.845},{"w":"laughing","s":76.845,"e":77.165},{"w":"at","s":77.165,"e":77.325},{"w":"these","s":77.325,"e":77.485},{"w":"poor","s":77.485,"e":77.725},{"w":"guys","s":77.725,"e":78.045},{"w":"and","s":78.045,"e":78.205},{"w":"their","s":78.205,"e":78.365},{"w":"bird","s":78.365,"e":78.605},{"w":"apocalypse.","s":78.605,"e":79.645}]},{"speaker":"Alice","start":79.965,"end":91.74,"text":"Feel bad, then keep laughing. The government gave these veterans farmland out west. Wheat prices collapsed, promised subsidies never came — and then twenty thousand emus marched straight into their crops.","words":[{"w":"Feel","s":79.965,"e":80.205},{"w":"bad,","s":80.205,"e":80.765},{"w":"then","s":80.765,"e":80.925},{"w":"keep","s":80.925,"e":81.165},{"w":"laughing.","s":81.165,"e":81.885},{"w":"The","s":81.885,"e":82.125},{"w":"government","s":82.125,"e":82.445},{"w":"gave","s":82.445,"e":82.765},{"w":"these","s":82.765,"e":83.005},{"w":"veterans","s":83.005,"e":83.405},{"w":"farmland","s":83.405,"e":84.045},{"w":"out","s":84.045,"e":84.285},{"w":"west.","s":84.285,"e":84.525},{"w":"Wheat","s":84.86,"e":85.26},{"w":"prices","s":85.26,"e":85.66},{"w":"collapsed,","s":85.66,"e":86.46},{"w":"promised","s":86.46,"e":86.86},{"w":"subsidies","s":86.86,"e":87.42},{"w":"never","s":87.42,"e":87.82},{"w":"came","s":87.82,"e":88.3},{"w":"—","s":88.3,"e":88.38},{"w":"and","s":88.38,"e":88.54},{"w":"then","s":88.54,"e":88.7},{"w":"twenty","s":88.7,"e":89.1},{"w":"thousand","s":89.1,"e":89.42},{"w":"emus","s":89.42,"e":89.98},{"w":"marched","s":89.98,"e":90.38},{"w":"straight","s":90.38,"e":90.7},{"w":"into","s":90.7,"e":90.94},{"w":"their","s":90.94,"e":91.1},{"w":"crops.","s":91.1,"e":91.74}]},{"speaker":"David","start":91.82,"end":95.66,"text":"Twenty thousand. That's not a flock, that's an army with feathers.","words":[{"w":"Twenty","s":91.82,"e":92.22},{"w":"thousand.","s":92.22,"e":92.94},{"w":"That's","s":92.94,"e":93.26},{"w":"not","s":93.26,"e":93.42},{"w":"a","s":93.42,"e":93.58},{"w":"flock,","s":93.58,"e":94.14},{"w":"that's","s":94.14,"e":94.38},{"w":"an","s":94.38,"e":94.54},{"w":"army","s":94.54,"e":94.86},{"w":"with","s":94.86,"e":95.02},{"w":"feathers.","s":95.02,"e":95.66}]},{"speaker":"Alice","start":96.14,"end":104.545,"text":"Exactly how the farmers saw it. Being ex-soldiers, they asked for a soldier's solution: machine guns. And the Minister of Defence said... sure.","words":[{"w":"Exactly","s":96.14,"e":96.54},{"w":"how","s":96.54,"e":96.78},{"w":"the","s":96.78,"e":96.94},{"w":"farmers","s":96.94,"e":97.42},{"w":"saw","s":97.42,"e":97.66},{"w":"it.","s":97.66,"e":97.74},{"w":"Being","s":98.065,"e":98.385},{"w":"ex-soldiers,","s":98.385,"e":99.345},{"w":"they","s":99.345,"e":99.505},{"w":"asked","s":99.505,"e":99.745},{"w":"for","s":99.745,"e":99.905},{"w":"a","s":99.905,"e":100.065},{"w":"soldier's","s":100.065,"e":100.545},{"w":"solution:","s":100.545,"e":101.265},{"w":"machine","s":101.265,"e":101.665},{"w":"guns.","s":101.665,"e":102.225},{"w":"And","s":102.225,"e":102.305},{"w":"the","s":102.305,"e":102.465},{"w":"Minister","s":102.465,"e":102.785},{"w":"of","s":102.785,"e":103.025},{"w":"Defence","s":103.025,"e":103.345},{"w":"said...","s":103.345,"e":103.905},{"w":"sure.","s":103.905,"e":104.545}]},{"speaker":"David","start":104.545,"end":106.865,"text":"No way. He just said yes?","words":[{"w":"No","s":104.545,"e":104.865},{"w":"way.","s":104.865,"e":105.425},{"w":"He","s":105.585,"e":105.745},{"w":"just","s":105.745,"e":105.985},{"w":"said","s":105.985,"e":106.225},{"w":"yes?","s":106.225,"e":106.865}]},{"speaker":"Alice","start":107.105,"end":115.91,"text":"He did. So in November 1932, Major Meredith arrives with two soldiers, two Lewis machine guns, and ten thousand rounds of ammunition.","words":[{"w":"He","s":107.105,"e":107.345},{"w":"did.","s":107.345,"e":107.825},{"w":"So","s":107.825,"e":107.985},{"w":"in","s":107.985,"e":108.225},{"w":"November","s":108.225,"e":108.625},{"w":"1932,","s":108.625,"e":109.985},{"w":"Major","s":109.985,"e":110.305},{"w":"Meredith","s":110.305,"e":110.785},{"w":"arrives","s":110.785,"e":111.265},{"w":"with","s":111.265,"e":111.425},{"w":"two","s":111.425,"e":111.745},{"w":"soldiers,","s":111.745,"e":112.065},{"w":"two","s":112.23,"e":112.55},{"w":"Lewis","s":112.55,"e":112.95},{"w":"machine","s":112.95,"e":113.35},{"w":"guns,","s":113.35,"e":113.83},{"w":"and","s":113.83,"e":113.99},{"w":"ten","s":113.99,"e":114.23},{"w":"thousand","s":114.23,"e":114.55},{"w":"rounds","s":114.55,"e":114.87},{"w":"of","s":114.87,"e":115.11},{"w":"ammunition.","s":115.11,"e":115.91}]},{"speaker":"David","start":116.15,"end":119.83,"text":"Against birds. I keep saying it because I keep not believing it.","words":[{"w":"Against","s":116.15,"e":116.39},{"w":"birds.","s":116.39,"e":117.19},{"w":"I","s":117.19,"e":117.35},{"w":"keep","s":117.35,"e":117.59},{"w":"saying","s":117.59,"e":117.91},{"w":"it","s":117.91,"e":118.07},{"w":"because","s":118.07,"e":118.31},{"w":"I","s":118.31,"e":118.55},{"w":"keep","s":118.55,"e":118.71},{"w":"not","s":118.71,"e":118.95},{"w":"believing","s":118.95,"e":119.27},{"w":"it.","s":119.27,"e":119.83}]},{"speaker":"Alice","start":120.07,"end":126.605,"text":"On paper it looked easy: big targets, open fields, trained gunners. The army thought it would take a week.","words":[{"w":"On","s":120.07,"e":120.39},{"w":"paper","s":120.39,"e":120.79},{"w":"it","s":120.79,"e":120.87},{"w":"looked","s":120.87,"e":121.11},{"w":"easy:","s":121.11,"e":121.67},{"w":"big","s":121.75,"e":122.07},{"w":"targets,","s":122.07,"e":122.71},{"w":"open","s":122.71,"e":123.03},{"w":"fields,","s":123.03,"e":123.67},{"w":"trained","s":123.67,"e":124.07},{"w":"gunners.","s":124.07,"e":124.47},{"w":"The","s":124.685,"e":124.925},{"w":"army","s":124.925,"e":125.245},{"w":"thought","s":125.245,"e":125.485},{"w":"it","s":125.485,"e":125.645},{"w":"would","s":125.645,"e":125.725},{"w":"take","s":125.725,"e":125.965},{"w":"a","s":125.965,"e":126.045},{"w":"week.","s":126.045,"e":126.605}]},{"speaker":"David","start":126.605,"end":128.925,"text":"Let me guess. It did not take a week.","words":[{"w":"Let","s":126.605,"e":126.765},{"w":"me","s":126.765,"e":127.005},{"w":"guess.","s":127.005,"e":127.485},{"w":"It","s":127.485,"e":127.725},{"w":"did","s":127.725,"e":127.885},{"w":"not","s":127.885,"e":128.125},{"w":"take","s":128.125,"e":128.285},{"w":"a","s":128.285,"e":128.445},{"w":"week.","s":128.445,"e":128.925}]},{"speaker":"Alice","start":129.085,"end":138.365,"text":"It went pear-shaped almost immediately. First ambush: the emus scattered into small groups, ran in zigzags, and the gun jammed after killing barely a dozen.","words":[{"w":"It","s":129.