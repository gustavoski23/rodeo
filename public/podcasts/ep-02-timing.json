":"case.","s":160.825,"e":161.385},{"w":"Those","s":161.385,"e":161.705},{"w":"birds","s":161.705,"e":162.025},{"w":"run","s":162.025,"e":162.265},{"w":"almost","s":162.265,"e":162.665},{"w":"fifty","s":162.665,"e":162.985},{"w":"kilometers","s":162.985,"e":163.465},{"w":"per","s":163.465,"e":163.785},{"w":"hour","s":163.785,"e":164.105},{"w":"and","s":164.105,"e":164.345},{"w":"shrug","s":164.345,"e":164.745},{"w":"off","s":164.745,"e":164.985},{"w":"multiple","s":164.985,"e":165.465},{"w":"bullets.","s":165.465,"e":165.785}]},{"speaker":"David","start":166.07,"end":170.15,"text":"Hold on — they tanked machine-gun fire? What are these things made of?","words":[{"w":"Hold","s":166.07,"e":166.39},{"w":"on","s":166.39,"e":166.87},{"w":"—","s":166.87,"e":166.91},{"w":"they","s":166.87,"e":167.03},{"w":"tanked","s":167.03,"e":167.43},{"w":"machine-gun","s":167.43,"e":168.07},{"w":"fire?","s":168.07,"e":168.63},{"w":"What","s":168.63,"e":168.79},{"w":"are","s":168.79,"e":168.95},{"w":"these","s":168.95,"e":169.19},{"w":"things","s":169.19,"e":169.43},{"w":"made","s":169.43,"e":169.67},{"w":"of?","s":169.67,"e":170.15}]},{"speaker":"Alice","start":170.95,"end":177.75,"text":"Meredith said that an army with the bullet-carrying capacity of these birds could face any force on Earth. Real quote, from the commander.","words":[{"w":"Meredith","s":170.95,"e":170.98999999999998},{"w":"said","s":170.95,"e":171.19},{"w":"that","s":171.19,"e":171.35},{"w":"an","s":171.35,"e":171.51},{"w":"army","s":171.51,"e":171.75},{"w":"with","s":171.75,"e":171.99},{"w":"the","s":171.99,"e":172.15},{"w":"bullet-carrying","s":172.15,"e":172.87},{"w":"capacity","s":172.87,"e":173.35},{"w":"of","s":173.35,"e":173.51},{"w":"these","s":173.51,"e":173.75},{"w":"birds","s":173.75,"e":174.07},{"w":"could","s":174.07,"e":174.31},{"w":"face","s":174.31,"e":174.63},{"w":"any","s":174.63,"e":174.87},{"w":"force","s":174.87,"e":175.19},{"w":"on","s":175.19,"e":175.35},{"w":"Earth.","s":175.35,"e":175.99},{"w"