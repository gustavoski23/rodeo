44.93}]},{"speaker":"Alice","start":144.93,"end":153.81,"text":"Exactly. 'This is a total rip-off,' or as a verb, 'they ripped me off.' Informal, extremely common, and always slightly outraged.","words":[{"w":"Exactly.","s":144.93,"e":146.05},{"w":"'This","s":146.05,"e":146.37},{"w":"is","s":146.37,"e":146.53},{"w":"a","s":146.53,"e":146.69},{"w":"total","s":146.69,"e":147.01},{"w":"rip-off,'","s":147.01,"e":147.65},{"w":"or","s":147.65,"e":147.89},{"w":"as","s":147.89,"e":148.05},{"w":"a","s":148.05,"e":148.21},{"w":"verb,","s":148.21,"e":148.69},{"w":"'they","s":148.69,"e":148.93},{"w":"ripped","s":148.93,"e":149.25},{"w":"me","s":149.25,"e":149.41},{"w":"off.'","s":149.41,"e":149.97},{"w":"Informal,","s":149.97,"e":150.85},{"w":"extremely","s":150.85,"e":151.49},{"w":"common,","s":151.49,"e":152.13},{"w":"and","s":152.13,"e":152.29},{"w":"always","s":152.29,"e":152.69},{"w":"slightly","s":152.69,"e":153.17},{"w":"outraged.","s":153.17,"e":153.81}]},{"speaker":"David","start":154.285,"end":158.445,"text":"The outrage is built into the word. Nobody calmly describes a rip-off.","words":[{"w":"The","s":154.285,"e":154.525},{"w":"outrage","s":154.525,"e":155.005},{"w":"is","s":155.005,"e":155.325},{"w":"built","s":155.325,"e":155.565},{"w":"into","s":155.565,"e":155.885},{"w":"the","s":155.885,"e":156.045},{"w":"word.","s":156.045,"e":156.605},{"w":"Nobody","s":156.765,"e":157.165},{"w":"calmly","s":157.165,"e":157.725},{"w":"describes","s":157.725,"e":158.285},{"w":"a","s":158.285,"e":158.445},{"w":"rip-off.","s":158.445,"e":158.48499999999999}]},{"speaker":"Alice","start":159.245,"end":163.565,"text":"Never. Okay, next exhibit: subscription plans.","words":[{"w":"Never.","s":159.245,"e":159.885},{"w":"Okay,","s":160.045,"e":160.765},{"w":"next","s":160.845,"e":161.165},{"w":"exhibit:","s":161.165,"e":161.965},{"w":"subscription","s":162.125,"e":162.765},{"w":"plans.","s":162.765,"e":163.565}]},{"speaker":"David","start":163.565,"end":164.445,"text":"Oh no.","words":[{"w":"Oh","s":163.565,"e":163.885},{"w":"no.","s":163.885,"e":164.445}]},{"speaker":"Alice","start":164.685,"end":172.75,"text":"There is a famous experiment by the behavioral economist Dan Ariely, using the old subscription page of The Economist magazine.","words":[{"w":"There","s":164.685,"e":164.925},{"w":"is","s":164.925,"e":165.165},{"w":"a","s":165.165,"e":165.325},{"w":"famous","s":165.325,"e":165.725},{"w":"experiment","s":165.725,"e":166.285},{"w":"by","s":166.285,"e":166.525},{"w":"the","s":166.525,"e":166.685},{"w":"behavioral","s":166.685,"e":167.245},{"w":"economist","s":167.245,"e":167.885},{"w":"Dan","s":167.885,"e":168.285},{"w":"Ariely,","s":168.285,"e":169.165},{"w":"using","s":169.07,"e":169.55},{"w":"the","s":169.55,"e":169.71},{"w":"old","s":169.71,"e":170.03},{"w":"subscription","s":170.03,"e":170.59},{"w":"page","s":170.59,"e":170.99},{"w":"of","s":170.99,"e":171.15},{"w":"The","s":171.15,"e":171.31},{"w":"Economist","s":171.31,"e":171.87},{"w":"magazine.","s":171.87,"e":172.75}]},{"speaker":"David","start":172.75,"end":174.99,"text":"The magazine? What did they do?","words":[{"w":"The","s":172.75,"e":172.99},{"w":"magazine?","s":172.99,"e":173.79},{"w":"What","s":173.87,"e":174.11},{"w":"did","s":174.11,"e":174.35},{"w":"they","s":174.35,"e":174.51},{"w":"do?","s":174.51,"e":174.99}]},{"speaker":"Alice","start":175.31,"end":184.235,"text":"Three options. Web only, cheap. Print only, expensive. And print plus web together, for exactly the same price as print alone.","words":[{"w":"Three","s":175.31,"e":175.63},{"w":"options.","s":175.63,"e":176.35},{"w":"Web","s":176.51,"e":176.83},{"w":"only,","s":176.83,"e":177.47},{"w":"cheap.","s":177.47,"e":178.11},{"w":"Print","s":178.11,"e":178.43},{"w":"only,","s":178.43,"e":178.91},{"w":"expensive.","s":178.91,"e":179.71},{"w":"And","s":179.79,"e":179.95},{"w":"print","s":179.95,"e":180.35},{"w":"plus","s":180.35,"e":180.59},{"w":"web","s":180.59,"e":180.91},{"w":"together,","s":180.91,"e":181.47},{"w":"for","s":181.595,"e":181.835},{"w":"exactly","s":181.835,"e":182.315},{"w":"the","s":182.315,"e":182.555},{"w":"same","s":182.555,"e":182.795},{"w":"price","s":182.795,"e":183.035},{"w":"as","s":183.035,"e":183.275},{"w":"print","s":183.275,"e":183.515},{"w":"alone.","s":183.515,"e":184.235}]},{"speaker":"David","start":184.235,"end":189.515,"text":"Wait, the same price? Then print only is pointless. Nobody would ever choose it.","words":[{"w":"Wait,","s":184.235,"e":184.795},{"w":"the","s":184.795,"e":185.035},{"w":"same","s":185.035,"e":185.355},{"w":"price?","s":185.355,"e":185.995},{"w":"Then","s":186.075,"e":186.315},{"w":"print","s":186.315,"e":186.635},{"w":"only","s":186.635,"e":186.955},{"w":"is","s":186.955,"e":187.115},{"w":"pointless.","s":187.115,"e":187.915},{"w":"Nobody","s":187.915,"e":188.395},{"w":"would","s":188.395,"e":188.555},{"w":"ever","s":188.555,"e":188.795},{"w":"choose","s":188.795,"e":189.115},{"w":"it.","s":189.115,"e":189.515}]},{"speaker":"Alice","start":189.675,"end":199.47,"text":"Nobody did. But with that useless option on the page, most people picked the expensive combo. Remove it, and most people picked the cheap web option instead.","words":[{"w":"Nobody","s":189.675,"e":190.235},{"w":"did.","s":190.235,"e":190.795},{"w":"But","s":190.875,"e":191.035},{"w":"with","s":191.035,"e":191.275},{"w":"that","s":191.275,"e":191.515},{"w":"useless","s":191.515,"e":191.995},{"w":"option","s":191.995,"e":192.395},{"w":"on","s":192.395,"e":192.555},{"w":"the","s":192.555,"e":192.715},{"w":"page,","s":192.715,"e":193.275},{"w":"most","s":193.275,"e":193.675},{"w":"people","s":193.675,"e":193.915},{"w":"picked","s":193.915,"e":194.235},{"w":"the","s":194.235,"e":194.475},{"w":"expensive","s":194.475,"e":195.035},{"w":"combo.","s":195.035,"e":195.435},{"w":"Remove","s":195.79,"e":196.27},{"w":"it,","s":196.27,"e":196.59},{"w":"and","s":196.59,"e":196.83},{"w":"most","s":196.83,"e":197.15},{"w":"people","s":197.15,"e":197.39},{"w":"picked","s":197.39,"e":197.71},{"w":"the","s":197.71,"e":197.87},{"w":"cheap","s":197.87,"e":198.11},{"w":"web","s":198.11,"e":198.43},{"w":"option","s":198.43,"e":198.83},{"w":"instead.","s":198.83,"e":199.47}]},{"speaker":"David","start":199.63,"end":206.27,"text":"So the pointless option quietly steered everyone toward spending more. That is elegant and evil at the same time.","words":[{"w":"So","s":199.63,"e":199.79},{"w":"the","s":199.79,"e":199.95},{"w":"pointless","s":199.95,"e":200.43},{"w":"option","s":200.43,"e":200.83},{"w":"quietly","s":200.83,"e":201.39},{"w":"steered","s":201.39,"e":201.87},{"w":"everyone","s":201.87,"e":202.35},{"w":"toward","s":202.35,"e":202.59},{"w":"spending","s":202.59,"e":203.07},{"w":"more.","s":203.07,"e":203.63},{"w":"That","s":203.87,"e":204.03},{"w":"is","s":204.03,"e":204.19},{"w":"elegant","s":204.19,"e":204.59},{"w":"and","s":204.59,"e":204.83},{"w":"evil","s":204.83,"e":205.15},{"w":"at","s":205.15,"e":205.39},{"w":"the","s":205.39,"e":205.55},{"w":"same","s":205.55,"e":205.79},{"w":"time.","s":205.79,"e":206.27}]},{"speaker":"Alice","start":206.59,"end":213.575,"text":"There is a lovely verb for that: to nudge someone into something. A nudge is literally a gentle push with your elbow.","words":[{"w":"There","s":206.59,"e":206.83},{"w":"is","s":206.83,"e":206.99},{"w":"a","s":206.99,"e":207.15},{"w":"lovely","s":207.15,"e":207.55},{"w":"verb","s":207.55,"e":207.87},{"w":"for","s":207.87,"e":208.03},{"w":"that:","s":208.03,"e":208.51},{"w":"to","s":208.51,"e":208.67},{"w":"nudge","s":208.67,"e":209.07},{"w":"someone","s":209.07,"e":209.47},{"w":"into","s":209.47,"e":209.79},{"w":"something.","s":209.79,"e":210.11},{"w":"A","s":210.455,"e":210.775},{"w":"nudge","s":210.775,"e":211.095},{"w":"is","s":211.095,"e":211.335},{"w":"literally","s":211.335,"e":211.735},{"w":"a","s":211.735,"e":211.975},{"w":"gentle","s":211.975,"e":212.375},{"w":"push","s":212.375,"e":212.615},{"w":"with","s":212.615,"e":212.855},{"w":"your","s":212.855,"