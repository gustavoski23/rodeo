,"s":16.395,"e":16.555},{"w":"resent","s":16.555,"e":16.875},{"w":"the","s":16.875,"e":17.035},{"w":"implication","s":17.035,"e":17.595},{"w":"that","s":17.595,"e":17.755},{"w":"a","s":17.755,"e":17.915},{"w":"snack","s":17.915,"e":18.155},{"w":"could","s":18.155,"e":18.395},{"w":"outsmart","s":18.395,"e":18.795},{"w":"me.","s":18.795,"e":19.155}]},{"speaker":"Sarah","start":19.455,"end":27.814,"text":"Oh, this is going to be delicious, because I watched you buy the large popcorn, and I am fairly certain you did exactly what the cinema wanted you to do.","words":[{"w":"Oh,","s":19.455,"e":19.835},{"w":"this","s":19.835,"e":19.995},{"w":"is","s":19.995,"e":20.155},{"w":"going","s":20.155,"e":20.315},{"w":"to","s":20.315,"e":20.395},{"w":"be","s":20.395,"e":20.555},{"w":"delicious,","s":20.555,"e":21.195},{"w":"because","s":21.195,"e":21.595},{"w":"I","s":21.595,"e":21.755},{"w":"watched","s":21.755,"e":22.075},{"w":"you","s":22.075,"e":22.235},{"w":"buy","s":22.235,"e":22.475},{"w":"the","s":22.475,"e":22.635},{"w":"large","s":22.635,"e":22.955},{"w":"popcorn,","s":22.955,"e":23.755},{"w":"and","s":23.915,"e":24.075},{"w":"I","s":24.075,"e":24.235},{"w":"am","s":24.235,"e":24.395},{"w":"fairly","s":24.395,"e":24.795},{"w":"certain","s":24.795,"e":25.115},{"w":"you","s":25.115,"e":25.355},{"w":"did","s":25.355,"e":25.595},{"w":"exactly","s":25.595,"e":26.075},{"w":"what","s":26.075,"e":26.235},{"w":"the","s":26.235,"e":26.395},{"w":"cinema","s":26.395,"e":26.795},{"w":"wanted","s":26.795,"e":27.115},{"w":"you","s":27.115,"e":27.275},{"w":"to","s":27.275,"e":27.355},{"w":"do.","s":27.355,"e":27.515}]},{"speaker":"Ethan","start":28.114,"end":37.959,"text":"No, no, I did the maths, thank you very much. The medium cost nearly as much as the large, so the large was obviously the smarter, more rational purchase.","words":[{"w":"No,","s":28.114,"e":28.81},{"w":"no,","s":28.81,"e":29.37},{"w":"I","s":29.45,"e":29.61},{"w":"did","s":29.61,"e":29.85},{"w":"the","s":29.85,"e":30.01},{"w":"maths,","s":30.01,"e":30.57},{"w":"thank","s":30.57,"e":30.81},{"w":"you","s":30.81,"e":30.97},{"w":"very","s":30.97,"e":31.21},{"w":"much.","s":31.21,"e":31.77},{"w":"The","s":32.01,"e":32.25},{"w":"medium","s":32.25,"e":32.57},{"w":"cost","s":32.57,"e":32.97},{"w":"nearly","s":32.97,"e":33.29},{"w":"as","s":33.29,"e":33.53},{"w":"much","s":33.53,"e":33.69},{"w":"as","s":33.69,"e":33.85},{"w":"the","s":33.85,"e":33.93},{"w":"large,","s":33.93,"e":34.57},{"w":"so","s":34.65,"e":34.81},{"w":"the","s":34.81,"e":34.97},{"w":"large","s":34.97,"e":35.21},{"w":"was","s":35.21,"e":35.45},{"w":"obviously","s":35.45,"e":35.85},{"w":"the","s":35.85,"e":36.09},{"w":"smarter,","s":36.09,"e":36.73},{"w":"more","s":36.73,"e":36.89},{"w":"rational","s":36.89,"e":37.29},{"w":"purchase.","s":37.29,"e":37.959}]},{"speaker":"Sarah","start":38.259,"end":48.151,"text":"Exactly, and that tiny gap between medium and large is not an accident, my friend. Somebody in an office designed that gap so your brain would do that little dance.","words":[{"w":"Exactly,","s":38.259,"e":38.97},{"w":"and","s":38.97,"e":39.13},{"w":"that","s":39.13,"e":39.37},{"w":"tiny","s":39.37,"e":39.77},{"w":"gap","s":39.77,"e":40.09},{"w":"between","s":40.09,"e":40.41},{"w":"medium","s":40.41,"e":40.81},{"w":"and","s":40.81,"e":40.97},{"w":"large","s":40.97,"e":41.53},{"w":"is","s":41.53,"e":41.77},{"w":"not","s":41.77,"e":42.01},{"w":"an","s":42.01,"e":42.17},{"w":"accident,","s":42.17,"e":42.73},{"w":"my","s":42.73,"e":42.89},{"w":"friend.","s":42.89,"e":43.13},{"w":"Somebody","s":43.475,"e":43.875},{"w":"in","s":43.875,"e":44.115},{"w":"an","s":44.115,"e":44.355},{"w":"office","s":44.355,"e":44.835},{"w":"designed","s":44.835,"e":45.315},{"w":"that","s":45.315,"e":45.555},{"w":"gap","s":45.555,"e":46.035},{"w":"so","s":46.035,"e":46.275},{"w":"your","s":46.275,"e":46.515},{"w":"brain","s":46.515,"e":46.755},{"w":"would","s":46.755,"e":46.995},{"w":"do","s":46.995,"e":47.075},{"w":"that","s":47.075,"e"