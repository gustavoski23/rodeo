,{"w":"medium","s":62.25,"e":62.65},{"w":"exists","s":62.65,"e":63.13},{"w":"purely","s":63.13,"e":63.69},{"w":"to","s":63.69,"e":63.85},{"w":"make","s":63.85,"e":64.09},{"w":"the","s":64.09,"e":64.25},{"w":"large","s":64.25,"e":64.57},{"w":"look","s":64.57,"e":64.89},{"w":"reasonable.","s":64.89,"e":65.69}]},{"speaker":"Ethan","start":66.008,"end":75.296,"text":"Okay, that is genuinely disturbing, because I have spent fifteen years of adult cinema trips congratulating myself on that exact decision like some kind of financial genius.","words":[{"w":"Okay,","s":66.008,"e":66.73},{"w":"that","s":66.73,"e":66.97},{"w":"is","s":66.97,"e":67.13},{"w":"genuinely","s":67.13,"e":67.69},{"w":"disturbing,","s":67.69,"e":68.49},{"w":"because","s":68.49,"e":68.73},{"w":"I","s":68.73,"e":68.89},{"w":"have","s":68.89,"e":69.05},{"w":"spent","s":69.05,"e":69.69},{"w":"fifteen","s":69.225,"e":69.785},{"w":"years","s":69.785,"e":69.945},{"w":"of","s":69.945,"e":70.105},{"w":"adult","s":70.105,"e":70.425},{"w":"cinema","s":70.425,"e":70.825},{"w":"trips","s":70.825,"e":71.145},{"w":"congratulating","s":71.145,"e":71.865},{"w":"myself","s":71.865,"e":72.265},{"w":"on","s":72.265,"e":72.505},{"w":"that","s":72.505,"e":72.665},{"w":"exact","s":72.665,"e":73.065},{"w":"decision","s":73.065,"e":73.385},{"w":"like","s":73.385,"e":73.625},{"w":"some","s":73.625,"e":73.865},{"w":"kind","s":73.865,"e":74.025},{"w":"of","s":74.025,"e":74.185},{"w":"financial","s":74.185,"e":74.665},{"w":"genius.","s":74.665,"e":75.296}]},{"speaker":"Sarah","start":75.596,"end":78.197,"text":"You fell for it. Completely and beautifully.","words":[{"w":"You","s":75.596,"e":75.785},{"w":"fell","s":75.785,"e":76.025},{"w":"for","s":76.025,"e":76.265},{"w":"it.","s":76.265,"e":76.745},{"w":"Completely","s":76.825,"e":77.225},{"w":"and","s":77.225,"e":77.465},{"w":"beautifully.","s":77.465,"e":78.185}]},{"speaker":"Ethan","start":78.497,"end":81.794,"text":"I did not fall for anything. I made an informed choice.","w