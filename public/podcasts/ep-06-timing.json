":"did","s":81.45,"e":81.69},{"w":"not","s":81.69,"e":81.93},{"w":"fall","s":81.93,"e":82.17},{"w":"for","s":82.17,"e":82.41},{"w":"anything.","s":82.41,"e":83.05},{"w":"I","s":83.05,"e":83.21},{"w":"made","s":83.21,"e":83.45},{"w":"an","s":83.45,"e":83.61},{"w":"informed","s":83.61,"e":84.09},{"w":"choice.","s":84.09,"e":84.73}]},{"speaker":"Alice","start":84.97,"end":94.89,"text":"'To fall for something' — honestly, that is the perfect phrase here. It means to be tricked by something, to believe the scam. You fall for a trick, a lie, a marketing ploy.","words":[{"w":"'To","s":84.97,"e":85.01},{"w":"fall","s":84.97,"e":85.21},{"w":"for","s":85.21,"e":85.45},{"w":"something'","s":85.45,"e":85.77},{"w":"—","s":85.77,"e":86.09},{"w":"honestly,","s":86.09,"e":86.65},{"w":"that","s":86.65,"e":86.97},{"w":"is","s":86.97,"e":87.13},{"w":"the","s":87.13,"e":87.29},{"w":"perfect","s":87.29,"e":87.69},{"w":"phrase","s":87.69,"e":88.09},{"w":"here.","s":88.09,"e":88.57},{"w":"It","s":88.57,"e":88.81},{"w":"means","s":88.81,"e":89.05},{"w":"to","s":89.05,"e":89.21},{"w":"be","s":89.21,"e":89.37},{"w":"tricked","s":89.37,"e":89.69},{"w":"by","s":89.69,"e":89.93},{"w":"something,","s":89.93,"e":90.57},{"w":"to","s":90.57,"e":90.73},{"w":"believe","s":90.73,"e":91.05},{"w":"the","s":91.05,"e":91.29},{"w":"scam.","s":91.29,"e":91.93},{"w":"You","s":91.93,"e":92.17},{"w":"fall","s":92.17,"e":92.41},{"w":"for","s":92.41,"e":92.57},{"w":"a","s":92.57,"e":92.73},{"w":"trick,","s":92.73,"e":93.21},{"w":"a","s":93.21,"e":93.45},{"w":"lie,","s":93.45,"e":93.85},{"w":"a","s":93.85,"e":94.09},{"w":"marketing","s":94.09,"e":94.49},{"w":"ploy.","s":94.49,"e":94.89}]},{"speaker":"David","start":95.315,"end":100.835,"text":"You can also fall for a person, though. Same verb, wildly different consequences.","words":[{"w":"You","s":95.315,"e":95.635},{"w":"can","s":95.635,"e":95.795},{"w":"also","s":95.795,"e":96.115},{"w":"fall","s":96.115,"e":96.435},{"w":"for","s":96.435,"e":96.595},{"w":"a","s":96.595,"e":96.755},{"w":"person,","s":96.755,"e":97.075},{"w":"though.","s":97.075,"e":97.715},{"w":"Same","s":97.715,"e":98.115},{"w":"verb,","s":98.115,"e":98.835},{"w":"wildly","s":98.835,"e":99.315},{"w":"different","s":99.315,"e":99.715},{"w":"consequences.","s":99.715,"e":100.835}]},{"speaker":"Alice","start":100.915,"end":108.915,"text":"And usually cheaper. The key sentence is 'I can't believe I fell for it' — that is what you say the moment you realize you have been played.","words":[{"w":"And","s":100.915,"e":101.155},{"w":"usually","s":101.155,"e":101.635},{"w":"cheaper.","s":101.635,"e":102.275},{"w":"The","s":102.275,"e":102.595},{"w":"key","s":102.595,"e":102.835},{"w":"sentence","s":102.835,"e":103.315},{"w":"is","s":103.315,"e":103.875},{"w":"'I","s":103.875,"e":104.035},{"w":"can't","s":104.035,"e":104.355},{"w":"believe","s":104.355,"e":104.675},{"w":"I","s":104.675,"e":104.915},{"w":"fell","s":104.915,"e":105.235},{"w":"for","s":105.235,"e":105.395},{"w":"it'","s":105.395,"e":105.595},{"w":"—","s":105.595,"e":105.795},{"w":"that","s":105.795,"e":106.035},{"w":"is","s":106.035,"e":106.195},{"w":"what","s":106.195,"e":106.435},{"w":"you","s":106.435,"e":106.595},{"w":"say","s":106.595,"e":106.835},{"w":"the","s":106.835,"e":107.075},{"w":"moment","s":107.075,"e":107.315},{"w":"you","s":107.315,"e":107.555},{"w":"realize","s":107.555,"e":108.035},{"w":"you","s":108.035,"e":108.195},{"w":"have","s":108.195,"e":108.435},{"w":"been","s":108.435,"e":108.595},{"w":"played.","s":108.595,"e":108.915}]},{"speaker":"David","start":109.53,"end":114.09,"text":"Fine. Noted. Give me another crime scene, beyond popcorn.","words":[{"w":"Fine.","s":109.53,"e":110.17},{"w":"Noted.","s":110.25,"e":110.89},{"w":"Give","s":110.89,"e":111.21},{"w":"me","s":111.21,"e":111.45},{"w":"another","s":111.45,"e":111.77},{"w":"crime","s":111.77,"e":112.17},{"w":"scene,","s":112.17,"e":112.81},{"w":"beyond","s":112.81,"e":113.13},{"w":"popcorn.","s":113.13,"e":114.09}]},{"speak