165.285},{"w":"metaphorical","s":165.285,"e":166.005},{"w":"—","s":166.005,"e":166.26},{"w":"a","s":166.26,"e":166.5},{"w":"builder","s":166.5,"e":166.82},{"w":"cutting","s":166.82,"e":167.22},{"w":"corners","s":167.22,"e":167.62},{"w":"on","s":167.62,"e":167.78},{"w":"materials,","s":167.78,"e":168.5},{"w":"a","s":168.5,"e":168.66},{"w":"student","s":168.66,"e":168.9},{"w":"on","s":168.9,"e":169.22},{"w":"citations.","s":169.22,"e":170.02},{"w":"Fred","s":170.5,"e":170.74},{"w":"took","s":170.74,"e":171.06},{"w":"it","s":171.06,"e":171.14},{"w":"beautifully","s":171.14,"e":171.86},{"w":"literally.","s":171.86,"e":172.475}]},{"speaker":"Ethan","start":172.775,"end":179.23,"text":"If your contractor cuts corners, your ceiling leaks. If Fred cuts corners, he nearly wins the Olympics.","words":[{"w":"If","s":172.775,"e":172.98},{"w":"your","s":172.98,"e":173.14},{"w":"contractor","s":173.14,"e":173.7},{"w":"cuts","s":173.7,"e":173.94},{"w":"corners,","s":173.94,"e":174.66},{"w":"your","s":174.66,"e":174.9},{"w":"ceiling","s":174.9,"e":175.22},{"w":"leaks.","s":175.22,"e":175.94},{"w":"If","s":176.26,"e":176.42},{"w":"Fred","s":176.42,"e":176.74},{"w":"cuts","s":176.74,"e":177.06},{"w":"corners,","s":177.06,"e":177.7},{"w":"he","s":177.7,"e":177.86},{"w":"nearly","s":177.86,"e":178.18},{"w":"wins","s":178.18,"e":178.42},{"w":"the","s":178.42,"e":178.58},{"w":"Olympics.","s":178.58,"e":178.98}]},{"speaker":"Sarah","start":179.53,"end":184.36,"text":"Meanwhile the real leader, Thomas Hicks, is out there falling apart in slow motion.","words":[{"w":"Meanwhile","s":179.53,"e":180.075},{"w":"the","s":180.075,"e":180.155},{"w":"real","s":180.155,"e":180.395},{"w":"leader,","s":180.395,"e":180.875},{"w":"Thomas","s":180.875,"e":181.195},{"w":"Hicks,","s":181.195,"e":181.675},{"w":"is","s":181.675,"e":181.835},{"w":"out","s":181.835,"e":181.995},{"w":"there","s":181.995,"e":182.235},{"w":"falling","s":182.235,"e":182.715},{"w":"apart","s":182.715,"e":183.035},{"w":"in","s":183.035,"e":183.275},{"w":"slow","s":183.275,"e":183.515},{"w":"motion.","s":183.515,"e":184.075}]},{"speaker":"Ethan","start":184.66,"end":192.926,"text":"Falling apart is generous. He's begging for water, and his trainers refuse — instead they feed him strychnine. Which is rat poison.","words":[{"w":"Falling","s":184.715,"e":185.115},{"w":"apart","s":185.115,"e":185.355},{"w":"is","s":185.355,"e":185.595},{"w":"generous.","s":185.595,"e":186.395},{"w":"He's","s":186.555,"e":186.875},{"w":"begging","s":186.875,"e":187.195},{"w":"for","s":187.195,"e":187.355},{"w":"water,","s":187.355,"e":187.995},{"w":"and","s":187.995,"e":188.155},{"w":"his","s":188.155,"e":188.395},{"w":"trainers","s":188.395,"e":188.795},{"w":"refuse","s":188.795,"e":189.515},{"w":"—","s":189.515,"e":189.595},{"w":"instead","s":189.595,"e":190.075},{"w":"they","s":190.075,"e":190.235},{"w":"feed","s":190.235,"e":190.475},{"w":"him","s":190.475,"e":190.635},{"w":"strychnine.","s":190.635,"e":191.595},{"w":"Which","s":191.755,"e":191.915},{"w":"is","s":191.915,"e":192.075},{"w":"rat","s":192.075,"e":192.395},{"w":"poison.","s":192.395,"e":192.795}]},{"speaker":"Sarah","start":193.226,"end":201.167,"text":"Mixed with raw egg whites. Later a second dose, washed down with brandy. That was legitimate sports medicine back then.","words":[{"w":"Mixed","s":193.226,"e":193.61},{"w":"with","s":193.61,"e":193.85},{"w":"raw","s":193.85,"e":194.33},{"w":"egg","s":194.33,"e":194.57},{"w":"whites.","s":194.57,"e":195.29},{"w":"Later","s":195.37,"e":195.69},{"w":"a","s":195.69,"e":195.93},{"w":"second","s":195.93,"e":196.25},{"w":"dose,","s":196.25,"e":196.89},{"w":"washed","s":196.89,"e":197.13},{"w":"down","s":197.13,"e":197.37},{"w":"with","s":197.37,"e":197.61},{"w":"brandy.","s":197.61,"e":198.49},{"w":"That","s":198.57,"e":198.81},{"w":"was","s":198.81,"e":198.97},{"w":"legitimate","s":198.97,"e":199.61},{"w":"sports","s":199.61,"e":200.01},{"w":"medicine","s":200.01,"e":200.49},{"w":"back","s":200.49,"e":200.73},{"w":"then.","s":200.73,"e":201.167}]},{"speaker":"Ethan","start":201.467,"end":209.223,"text":"A few miles from the finish, he completely hits the wall — hallucinating, shuffling, convinced the finish line is still twenty miles away.","words":[{"w":"A","s":201.467,"e":201.69},{"w":"few","s":201.69,"e":201.85},{"w":"miles","s":201.85,"e":202.09},{"w":"from","s":202.09,"e":202.33},{"w":"the","s":202.33,"e":202.41},{"w":"finish,","s":202.41,"e":202.97},{"w":"he","s":202.97,"e":203.21},{"w":"completely","s":203.21,"e":203.61},{"w":"hits","s":203.61,"e":203.93},{"w":"the","s":203.93,"e":204.09},{"w":"wall","s":204.09,"e":204.65},{"w":"—","s":204.65,"e":204.69},{"w":"hallucinating,","s":204.65,"e":205.37},{"w":"shuffling,","s":205.605,"e":206.485},{"w":"convinced","s":206.485,"e":206.805},{"w":"the","s":206.805,"e":207.045},{"w":"finish","s":207.045,"e":207.285},{"w":"line","s":207.285,"e":207.605},{"w":"is","s":207.605,"e":207.765},{"w":"still","s":207.765,"e":208.085},{"w":"twenty","s":208.085,"e":208.405},{"w":"miles","s":208.405,"e":208.725},{"w":"away.","s":208.725,"e":209.223}]},{"speaker":"Sarah","start":209.523,"end":216.953,"text":"There it is: to hit the wall. That moment when your energy simply vanishes and your body refuses to go on.","words":[{"w":"There","s":209.523,"e":209.845},{"w":"it","s":209.845,"e":210.005},{"w":"is:","s":210.005,"e":210.485},{"w":"to","s":210.485,"e":210.725},{"w":"hit","s":210.725,"e":210.965},{"w":"the","s":210.965,"e":211.045},{"w":"wall.","s":211.045,"e":211.605},{"w":"That","s":211.845,"e":212.085},{"w":"moment","s":212.085,"e":212.565},{"w":"when","s":212.565,"e":212.965},{"w":"your","s":212.965,"e":213.205},{"w":"energy","s":213.205,"e":213.605},{"w":"simply","s":213.605,"e":214.005},{"w":"vanishes","s":214.005,"e":214.645},{"w":"and","s":214.645,"e":214.965},{"w":"your","s":214.965,"e":215.205},{"w":"body","s":215.205,"e":215.525},{"w":"refuses","s":215.525,"e":216.085},{"w":"to","s":216.085,"e":216.165},{"w":"go","s":216.165,"e":216.405},{"w":"on.","s":216.405,"e":216.885}]},{"speaker":"Ethan","start":217.253,"end":223.708,"text":"Runners use it literally, but you can hit the wall studying, in a long meeting, halfway through any exhausting week.","words":[{"w":"Runners","s":217.253,"e":217.685},{"w":"use","s":217.685,"e":217.845},{"w":"it","s":217.845,"e":218.005},{"w":"literally,","s":218.005,"e":218.405},{"w":"but","s":218.61,"e":218.85},{"w":"you","s":218.85,"e":219.01},{"w":"can","s":219.01,"e":219.09},{"w":"hit","s":219.09,"e":219.33},{"w":"the","s":219.33,"e":219.41},{"w":"wall","s":219.41,"e":219.65},{"w":"studying,","s":219.65,"e":220.53},{"w":"in","s":220.53,"e":220.69},{"w":"a","s":220.69,"e":220.77},{"w":"long","s":220.77,"e":221.01},{"w":"meeting,","s":221.01,"e":221.73},{"w":"halfway","s":221.73,"e":222.13},{"w":"through","s":222.13,"e":222.45},{"w":"any","s":222.45,"e":222.69},{"w":"exhausting","s":222.69,"e":223.25},{"w":"week.","s":223.25,"e":223.708}]},{"speaker":"Sarah","start":224.008,"end":229.302,"text":"By ten p.m. on a Tuesday, I have thoroughly hit the wall. Ask anyone.","words":[{"w":"By","s":224.61,"e":225.01},{"w":"ten","s":225.01,"e":225.25},{"w":"p.m.","s":225.25,"e":225.65},{"w":"on","s":225.65,"e":225.81},{"w":"a","s":225.81,"e":225.97},{"w":"Tuesday,","s":225.97,"e":226.61},{"w":"I","s":226.61,"e":226.69},{"w":"have","s":226.69,"e":226.85},{"w":"thoroughly","s":226.85,"e":227.33},{"w":"hit","s":227.33,"e":227.49},{"w":"the","s":227.49,"e":227.65},{"w":"wall.","s":227.65,"e":228.21},{"w":"Ask","s":228.29,"e":228.61},{"w":"anyone.","s":228.61,"e":229.302}]},{"speaker":"Ethan","start":229.602,"end":235.036,"text":"So Hicks crosses the line held up by his trainers, legs pedaling the air like a cartoon character.","words":[{"w":"So","s":229.602,"e":229.73},{"w":"Hicks","s":229.73,"e":230.13},{"w":"crosses","s":230.13,"e":230.53},{"w":"the","s":230.53,"e":230.61},{"w":"line","s":230.61,"e":230.85},{"w":"held","s":230.85,"e":231.17},{"w":"up","s":231.17,"e"