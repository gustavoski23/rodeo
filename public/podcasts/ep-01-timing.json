25},{"w":"you","s":156.725,"e":156.965},{"w":"almost","s":156.965,"e":157.285},{"w":"stole","s":157.285,"e":157.525},{"w":"an","s":157.525,"e":157.765},{"w":"Olympic","s":157.765,"e":158.165},{"w":"title.","s":158.165,"e":158.805}]},{"speaker":"Alice","start":158.885,"end":164.46,"text":"The most extreme case of cutting corners ever recorded — except he cut eleven miles of them.","words":[{"w":"The","s":158.885,"e":159.045},{"w":"most","s":159.045,"e":159.365},{"w":"extreme","s":159.365,"e":159.765},{"w":"case","s":159.765,"e":160.085},{"w":"of","s":160.085,"e":160.245},{"w":"cutting","s":160.245,"e":160.645},{"w":"corners","s":160.645,"e":161.125},{"w":"ever","s":161.125,"e":161.445},{"w":"recorded","s":161.445,"e":161.925},{"w":"—","s":161.925,"e":162.22},{"w":"except","s":162.22,"e":162.62},{"w":"he","s":162.62,"e":162.78},{"w":"cut","s":162.78,"e":163.02},{"w":"eleven","s":163.02,"e":163.42},{"w":"miles","s":163.42,"e":163.82},{"w":"of","s":163.82,"e":163.98},{"w":"them.","s":163.98,"e":164.46}]},{"speaker":"David","start":164.86,"end":171.1,"text":"Right, to cut corners: doing something the cheap, lazy way, skipping the steps you're supposed to take.","words":[{"w":"Right,","s":164.86,"e":165.42},{"w":"to","s":165.42,"e":165.66},{"w":"cut","s":165.66,"e":165.9},{"w":"corners:","s":165.9,"e":166.62},{"w":"doing","s":166.7,"e":167.02},{"w":"something","s":167.02,"e":167.34},{"w":"the","s":167.34,"e":167.66},{"w":"cheap,","s":167.66,"e":168.14},{"w":"lazy","s":168.14,"e":168.38},{"w":"way,","s":168.38,"e":169.02},{"w":"skipping","s":169.02,"e":169.42},{"w":"the","s":169.42,"e":169.58},{"w":"steps","s":169.58,"e":169.9},{"w":"you're","s":169.9,"e":170.22},{"w":"supposed","s":170.22,"e":170.46},{"w":"to","s":170.46,"e":170.62},{"w":"take.","s":170.62,"e":171.1}]},{"speaker":"Alice","start":171.18,"end":179.675,"text":"Usually metaphorical — a builder cutting corners on materials, a student on citations. Fred took it beautifully literally.","words":[{"w":"Usually","s":171.18,"e":171.58},{"w":"metaphorical","s":171.58,"e":172.7},{"w":"—","s":172.7,"e":172.78},{"w":"a","s":172.78,"e":172.94},{"w":"builder","s":172.94,"e":173.34},{"w":"cutting","s":173.34,"e":173.74},{"w":"corners","s":173.74,"e":174.22},{"w":"on","s":174.22,"e":174.46},{"w":"materials,","s":174.46,"e":175.26},{"w":"a","s":175.5,"e":175.66},{"w":"student","s":175.66,"e":175.98},{"w":"on","s":175.98,"e":176.3},{"w":"citations.","s":176.3,"e":176.94},{"w":"Fred","s":177.595,"e":177.995},{"w":"took","s":177.995,"e":178.235},{"w":"it","s":178.235,"e":178.475},{"w":"beautifully","s":178.475,"e":178.875},{"w":"literally.","s":178.875,"e":179.675}]},{"speaker":"David","start":179.835,"end":186.395,"text":"If your contractor cuts corners, your ceiling leaks. If Fred cuts corners, he nearly wins the Olympics.","words":[{"w":"If","s":179.835,"e":180.155},{"w":"your","s":180.155,"e":180.315},{"w":"contractor","s":180.315,"e":180.955},{"w":"cuts","s":180.955,"e":181.275},{"w":"corners,","s":181.275,"e":181.915},{"w":"your","s":181.915,"e":182.155},{"w":"ceiling","s":182.155,"e":182.475},{"w":"leaks.","s":182.475,"e":183.195},{"w":"If","s":183.275,"e":183.515},{"w":"Fred","s":183.515,"e":183.835},{"w":"cuts","s":183.835,"e":184.155},{"w":"corners,","s":184.155,"e":184.715},{"w":"he","s":184.715,"e":184.875},{"w":"nearly","s":184.875,"e":185.195},{"w":"wins","s":185.195,"e":185.515},{"w":"the","s":185.515,"e":185.675},{"w":"Olympics.","s":185.675,"e":186.395}]},{"speaker":"Alice","start":186.475,"end":191.195,"text":"Meanwhile the real leader, Thomas Hicks, is out there falling apart in slow motion.","words":[{"w":"Meanwhile","s":186.475,"e":187.035},{"w":"the","s":187.035,"e":187.115},{"w":"real","s":187.115,"e":187.435},{"w":"leader,","s":187.435,"e":188.075},{"w":"Thomas","s":188.075,"e":188.475},{"w":"Hicks,","s":188.475,"e":189.035},{"w":"is","s":189.035,"e":189.195},{"w":"out","s":189.195,"e":189.355},{"w":"there","s":189.355,"e":189.595},{"w":"falling","s":189.595,"e":190.075},{"w":"apart","s":190.075,"e":190.395},{"w":"in","s":190.395,"e":190.635},{"w":"slow","s":190.635,"e":190.955},{"w":"motion.","s":190.955,"e":191.195}]},{"speaker":"David","start":191.97,"end":200.45,"text":"Falling apart is generous. He's begging for water, and his trainers refuse — instead they feed him strychnine. Which is rat poison.","words":[{"w":"Falling","s":191.97,"e":192.37},{"w":"apart","s":192.37,"e":192.69},{"w":"is","s":192.69,"e":192.93},{"w":"generous.","s":192.93,"e":193.65},{"w":"He's","s":193.81,"e":194.05},{"w":"begging","s":194.05,"e":194.45},{"w":"for","s":194.45,"e":194.61},{"w":"water,","s":194.61,"e":195.25},{"w":"and","s":195.33,"e":195.49},{"w":"his","s":195.49,"e":195.65},{"w":"trainers","s":195.65,"e":196.13},{"w":"refuse","s":196.13,"e":196.93},{"w":"—","s":196.93,"e":197.09},{"w":"instead","s":197.09,"e":197.57},{"w":"they","s":197.57,"e":197.65},{"w":"feed","s":197.65,"e":197.89},{"w":"him","s":197.89,"e":198.05},{"w":"strychnine.","s":198.05,"e":199.01},{"w":"Which","s":199.01,"e":199.25},{"w":"is","s":199.25,"e":199.41},{"w":"rat","s":199.41,"e":199.73},{"w":"poison.","s":199.73,"e":200.45}]},{"speaker":"Alice","start":200.53,"end":208.245,"text":"Mixed with raw egg whites. Later a second dose, washed down with brandy. That was legitimate sports medicine back then.","words":[{"w":"Mixed","s":200.53,"e":200.85},{"w":"with","s":200.85,"e":201.01},{"w":"raw","s":201.01,"e":201.33},{"w":"egg","s":201.33,"e":201.57},{"w":"whites.","s":201.57,"e":202.29},{"w":"Later","s":202.29,"e":202.61},{"w":"a","s":202.61,"e":202.85},{"w":"second","s":202.85,"e":203.17},{"w":"dose,","s":203.17,"e":203.81},{"w":"washed","s":203.81,"e":204.13},{"w":"down","s":204.13,"e":204.45},{"w":"with","s":204.45,"e":204.61},{"w":"brandy.","s":204.61,"e":205.17},{"w":"That","s":205.525,"e":205.845},{"w":"was","s":205.845,"e":206.005},{"w":"legitimate","s":206.005,"e":206.565},{"w":"sports","s":206.565,"e":206.965},{"w":"medicine","s":206.965,"e":207.445},{"w":"back","s":207.445,"e":207.765},{"w":"then.","s":207.765,"e":208.245}]},{"speaker":"David","start":208.645,"end":217.045,"text":"A few miles from the finish, he completely hits the wall — hallucinating, shuffling, convinced the finish line is still twenty miles away.","words":[{"w":"A","s":208.645,"e":208.885},{"w":"few","s":208.885,"e":209.045},{"w":"miles","s":209.045,"e":209.365},{"w":"from","s":209.365,"e":209.605},{"w":"the","s":209.605,"e":209.765},{"w":"finish,","s":209.765,"e":210.325},{"w":"he","s":210.325,"e":210.565},{"w":"completely","s":210.565,"e":211.045},{"w":"hits","s":211.045,"e":211.365},{"w":"the","s":211.365,"e":211.525},{"w":"wall","s":211.525,"e":212.085},{"w":"—","s":212.085,"e":212.165},{"w":"hallucinating,","s":212.165,"e":213.205},{"w":"shuffling,","s":213.205,"e":214.085},{"w":"convinced","s":214.085,"e":214.485},{"w":"the","s":214.485,"e":214.725},{"w":"finish","s":214.725,"e":215.045},{"w":"line","s":215.045,"e":215.285},{"w":"is","s":215.285,"e":215.525},{"w":"still","s":215.525,"e":215.765},{"w":"twenty","s":215.765,"e":216.085},{"w":"miles","s":216.085,"e":216.405},{"w":"away.","s":216.405,"e":217.045}]},{"speaker":"Alice","start":217.205,"end":224.14,"text":"There it is: to hit the wall. That moment when your energy simply vanishes and your body refuses to go on.","words":[{"w":"There","s":217.205,"e":217.445},{"w":"it","s":217.445,"e":217.605},{"w":"is:","s":217.605,"e":217.765},{"w":"to","s":218.06,"e":218.3},{"w":"hit","s":218.3,"e":218.54},{"w":"the","s":218.54,"e":218.7},{"w":"wall.","s":218.7,"e":219.26},{"w":"That","s":219.34,"e":219.58},{"w":"moment","s":219.58,"e":219.9},{"w":"when","s":219.9,"e":220.22},{"w":"your","s":220.22,"e":220.38},{"w":"energy","s":220.38,"e":220.86},{"w":"simply","s":220.86,"e":221.26},{"w":"vanishes","s":221.26,"e":221.82},{"w":"and","s":221.82,"e":222.14},{"w":"your","s":222.14,"e":222.38},{"w":"body","s":222.38,"e":222.7},{"w":"refuses","s":222.7,"e":223.26},{"w":"to","s":223.26,"e":223.42},{"w"