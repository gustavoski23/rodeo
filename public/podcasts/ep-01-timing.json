","s":104.165,"e":104.485},{"w":"by","s":104.485,"e":104.725},{"w":"Wednesday.","s":104.725,"e":105.445}]},{"speaker":"Ethan","start":105.746,"end":111.644,"text":"Grim but useful. Okay, back to the race. First runner enters the stadium...","words":[{"w":"Grim","s":105.746,"e":106.085},{"w":"but","s":106.085,"e":106.325},{"w":"useful.","s":106.325,"e":107.045},{"w":"Okay,","s":107.525,"e":108.245},{"w":"back","s":108.405,"e":108.645},{"w":"to","s":108.645,"e":108.805},{"w":"the","s":108.805,"e":108.885},{"w":"race.","s":108.885,"e":109.525},{"w":"First","s":109.925,"e":110.245},{"w":"runner","s":110.245,"e":110.565},{"w":"enters","s":110.565,"e":110.885},{"w":"the","s":110.885,"e":111.045},{"w":"stadium...","s":111.045,"e":111.445}]},{"speaker":"Sarah","start":112.164,"end":119.78,"text":"Fred Lorz! A bricklayer from New York, looking suspiciously fresh for a man who just ran almost twenty-five miles in an oven.","words":[{"w":"Fred","s":112.164,"e":112.53},{"w":"Lorz!","s":112.53,"e":113.41},{"w":"A","s":113.41,"e":113.65},{"w":"bricklayer","s":113.65,"e":114.13},{"w":"from","s":114.13,"e":114.37},{"w":"New","s":114.37,"e":114.53},{"w":"York,","s":114.53,"e":115.09},{"w":"looking","s":115.09,"e":115.33},{"w":"suspiciously","s":115.33,"e":116.05},{"w":"fresh","s":116.05,"e":116.37},{"w":"for","s":116.37,"e":116.53},{"w":"a","s":116.53,"e":116.69},{"w":"man","s":116.69,"e":116.85},{"w":"who","s":116.85,"e":117.09},{"w":"just","s":117.09,"e":117.33},{"w":"ran","s":117.33,"e":117.65},{"w":"almost","s":117.65,"e":118.05},{"w":"twenty-five","s":118.05,"e":118.61},{"w":"miles","s":118.61,"e":118.85},{"w":"in","s":118.85,"e":119.09},{"w":"an","s":119.09,"e":119.25},{"w":"oven.","s":119.25,"e":119.78}]},{"speaker":"Ethan","start":120.08,"end":126.396,"text":"Because he hadn't. He got cramps at mile nine, flagged down a car, and rode it for eleven miles.","words":[{"w":"Because","s":120.08,"e":120.37},{"w":"he","s":120.37,"e":120.53},{"w":"hadn't.","s":120.53,"e":121.17},{"w":"He","s":121.25,"e":121.41},{"w":"got","s":121.41,"e":121.65},{"w":"cramps","s":121.65,"e":122.05},{"w":"at","s":122.05,"e":122.21},{"w":"mile","s":122.21,"e":122.53},{"w":"nine,","s":122.53,"e":123.17},{"w":"flagged","s":123.25,"e":123.57},{"w":"down","s":123.57,"e":123.81},{"w":"a","s":123.81,"e":123.97},{"w":"car,","s":123.97,"e":124.53},{"w":"and","s":124.69,"e":124.77},{"w":"rode","s":124.77,"e":125.09},{"w":"it","s":125.09,"e":125.17},{"w":"for","s":125.17,"e":125.33},{"w":"eleven","s":125.33,"e":125.73},{"w":"miles.","s":125.73,"e":126.05}]},{"speaker":"Sarah","start":126.696,"end":132.873,"text":"Waving at the other runners as he passed them, which is my favorite detail in all of sports history.","words":[{"w":"Waving","s":126.696,"e":127.245},{"w":"at","s":127.245,"e":127.485},{"w":"the","s":127.485,"e":127.645},{"w":"other","s":127.645,"e":127.885},{"w":"runners","s":127.885,"e":128.285},{"w":"as","s":128.285,"e":128.445},{"w":"he","s":128.445,"e":128.605},{"w":"passed","s":128.605,"e":128.845},{"w":"them,","s":128.845,"e":129.405},{"w":"which","s":129.725,"e":129.965},{"w":"is","s":129.965,"e":130.205},{"w":"my","s":130.205,"e":130.525},{"w":"favorite","s":130.525,"e":130.925},{"w":"detail","s":130.925,"e":131.325},{"w":"in","s":131.325,"e":131.565},{"w":"all","s":131.565,"e":131.725},{"w":"of","s":131.725,"e":131.885},{"w":"sports","s":131.885,"e":132.205},{"w":"history.","s":132.205,"e":132.845}]},{"speaker":"Ethan","start":133.173,"end":139.907,"text":"Then the car breaks down, Lorz feels better, jogs the rest, and enters the stadium first to a roaring crowd.","words":[{"w":"Then","s":133.173,"e":133.325},{"w":"the","s":133.325,"e":133.485},{"w":"car","s":133.485,"e":133.725},{"w":"breaks","s":133.725,"e":134.045},{"w":"down,","s":134.045,"e":134.605},{"w":"Lorz","s":134.605,"e":135.165},{"w":"feels","s":135.165,"e":135.485},{"w":"better,","s":135.485,"e":136.125},{"w":"jogs","s":136.125,"e":136.525},{"w":"the","s":136.525,"e":136.685},{"w":"rest,","