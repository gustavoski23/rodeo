16.865,"e":17.105},{"w":"more","s":17.105,"e":17.345},{"w":"slapstick","s":17.345,"e":17.985},{"w":"comedy","s":17.985,"e":18.625},{"w":"with","s":18.625,"e":18.945},{"w":"medals","s":18.945,"e":19.345},{"w":"attached.","s":19.345,"e":20.145}]},{"speaker":"Alice","start":20.545,"end":32,"text":"So picture the scene: thirty-two runners line up in St. Louis on a brutally hot August afternoon, ninety degrees Fahrenheit, on dusty country roads shared with cars and horses.","words":[{"w":"So","s":20.545,"e":20.785},{"w":"picture","s":20.785,"e":21.105},{"w":"the","s":21.105,"e":21.345},{"w":"scene:","s":21.345,"e":21.905},{"w":"thirty-two","s":21.905,"e":22.625},{"w":"runners","s":22.625,"e":23.025},{"w":"line","s":23.025,"e":23.345},{"w":"up","s":23.345,"e":23.505},{"w":"in","s":23.505,"e":23.665},{"w":"St.","s":23.665,"e":23.985},{"w":"Louis","s":23.985,"e":24.385},{"w":"on","s":24.385,"e":24.705},{"w":"a","s":24.705,"e":24.865},{"w":"brutally","s":24.865,"e":25.265},{"w":"hot","s":25.265,"e":25.585},{"w":"August","s":25.585,"e":26.145},{"w":"afternoon,","s":26.145,"e":26.625},{"w":"ninety","s":27.04,"e":27.44},{"w":"degrees","s":27.44,"e":27.84},{"w":"Fahrenheit,","s":27.84,"e":28.8},{"w":"on","s":28.8,"e":28.96},{"w":"dusty","s":28.96,"e":29.44},{"w":"country","s":29.44,"e":29.76},{"w":"roads","s":29.76,"e":30.16},{"w":"shared","s":30.16,"e":30.56},{"w":"with","s":30.56,"e":30.8},{"w":"cars","s":30.8,"e":31.12},{"w":"and","s":31.12,"e":31.28},{"w":"horses.","s":31.28,"e":32}]},{"speaker":"David","start":32.32,"end":43.855,"text":"And here's the detail that genuinely horrifies me: the organizers deliberately limited the water stations, because one official wanted to study the effects of dehydration on the human body.","words":[{"w":"And","s":32.32,"e":32.64},{"w":"here's","s":32.64,"e":32.88},{"w":"the","s":32.88,"e":33.04},{"w":"detail","s":33.04,"e":33.36},{"w":"that","s":33.36,"e":33.6},{"w":"genuinely","s":33.6,"e":34.16},{"w":"horrifies","s":34.16,"e":34.72},{"w"