ore","s":113.87,"e":114.19},{"w":"the","s":114.19,"e":114.35},{"w":"operation,","s":114.35,"e":115.07},{"w":"and","s":115.31,"e":115.47},{"w":"there","s":115.47,"e":115.63},{"w":"was","s":115.63,"e":115.71},{"w":"arthritis","s":115.71,"e":116.35},{"w":"after.","s":116.35,"e":116.985}]},{"speaker":"Ethan","start":117.285,"end":127.13,"text":"True, the cartilage didn't change at all. But the pain did. That's the placebo effect at full power. Mind over matter, in the most literal sense possible.","words":[{"w":"True,","s":117.39,"e":117.95},{"w":"the","s":117.95,"e":118.19},{"w":"cartilage","s":118.19,"e":118.67},{"w":"didn't","s":118.67,"e":118.91},{"w":"change","s":118.91,"e":119.23},{"w":"at","s":119.23,"e":119.47},{"w":"all.","s":119.47,"e":119.87},{"w":"But","s":120.11,"e":120.27},{"w":"the","s":120.27,"e":120.43},{"w":"pain","s":120.43,"e":120.75},{"w":"did.","s":120.75,"e":121.31},{"w":"That's","s":121.55,"e":121.79},{"w":"the","s":121.79,"e":121.95},{"w":"placebo","s":121.95,"e":122.43},{"w":"effect","s":122.43,"e":122.75},{"w":"at","s":122.75,"e":122.99},{"w":"full","s":122.99,"e":123.23},{"w":"power.","s":123.23,"e":123.55},{"w":"Mind","s":124.185,"e":124.505},{"w":"over","s":124.505,"e":124.745},{"w":"matter,","s":124.745,"e":125.305},{"w":"in","s":125.305,"e":125.465},{"w":"the","s":125.465,"e":125.625},{"w":"most","s":125.625,"e":125.785},{"w":"literal","s":125.785,"e":126.185},{"w":"sense","s":126.185,"e":126.505},{"w":"possible.","s":126.505,"e":127.13}]},{"speaker":"Sarah","start":127.43,"end":136.254,"text":"Ah, there it is — mind over matter. That's when your thoughts or your willpower overcome something physical. Pain, exhaustion, fear.","words":[{"w":"Ah,","s":127.43,"e":127.785},{"w":"there","s":127.785,"e":127.945},{"w":"it","s":127.945,"e":128.105},{"w":"is","s":128.105,"e":128.505},{"w":"—","s":128.505,"e":128.545},{"w":"mind","s":128.505,"e":128.825},{"w":"over","s":128.825,"e":129.145},{"w":"matter.","s":129.145,"e":129.785},{"w":"That's","s":129.865,"e":130.185},{"w":"when","s":130.185,"e":130.425},{"w":"your","s":130.425,"e":130.745},{"w":"thoughts","s":130.745,"e":131.065},{"w":"or","s":131.065,"e":131.305},{"w":"your","s":131.305,"e":131.545},{"w":"willpower","s":131.545,"e":132.105},{"w":"overcome","s":132.105,"e":132.745},{"w":"something","s":132.745,"e":133.145},{"w":"physical.","s":133.145,"e":133.945},{"w":"Pain,","s":134.025,"e":134.745},{"w":"exhaustion,","s":134.745,"e":135.625},{"w":"fear.","s":135.625,"e":135.945}]},{"speaker":"Ethan","start":136.554,"end":139.944,"text":"Like running the last mile of a marathon on pure stubbornness.","words":[{"w":"Like","s":136.554,"e":136.78},{"w":"running","s":136.78,"e":137.02},{"w":"the","s":137.02,"e":137.18},{"w":"last","s":137.18,"e":137.5},{"w":"mile","s":137.5,"e":137.74},{"w":"of","s":137.74,"e":137.9},{"w":"a","s":137.9,"e":138.06},{"w":"marathon","s":138.06,"e":138.46},{"w":"on","s":138.46,"e":138.7},{"w":"pure","s":138.7,"e":139.1},{"w":"stubbornness.","s":139.1,"e":139.944}]},{"speaker":"Sarah","start":140.244,"end":145.956,"text":"Or sitting through all four hours of your vacation photos. That was mind over matter, believe me.","words":[{"w":"Or","s":140.94,"e":141.1},{"w":"sitting","s":141.1,"e":141.5},{"w":"through","s":141.5,"e":141.66},{"w":"all","s":141.66,"e":141.9},{"w":"four","s":141.9,"e":142.14},{"w":"hours","s":142.14,"e":142.46},{"w":"of","s":142.46,"e":142.54},{"w":"your","s":142.54,"e":142.78},{"w":"vacation","s":142.78,"e":143.18},{"w":"photos.","s":143.18,"e":143.9},{"w":"That","s":143.9,"e":144.14},{"w":"was","s":144.14,"e":144.3},{"w":"mind","s":144.3,"e":144.62},{"w":"over","s":144.62,"e":144.86},{"w":"matter,","s":144.86,"e":145.34},{"w":"believe","s":145.34,"e":145.58},{"w":"me.","s":145.58,"e":145.956}]},{"speaker":"Ethan","start":146.256,"end":147.974,"text":"Rude. But fair.","words":[{"w":"Rude.","s":146.256,"e":147.02},{"w":"But","s":147.18,"e":147.34},{"w":"fair.","s":147.34,"e":147.974}]},{"speaker":"Sarah","start":148.274,"end":157.98,"text":"Here's my real objection, though. Before you declare a miracle, you have to rule out the boring explanations. Maybe those knees were simply going to improve on their own.","words":[{"w":"Here's","s":148.274,"e":148.62},{"w":"my","s":148.62,"e":148.78},{"w":"real","s":148.78,"e":149.1},{"w":"objection,","s":149.1,"e":149.42},{"w":"though.","s":149.42,"e":149.66},{"w":"Before","s":150.345,"e":150.825},{"w":"you","s":150.825,"e":150.985},{"w":"declare","s":150.985,"e":151.305},{"w":"a","s":151.305,"e":151.465},{"w":"miracle,","s":151.465,"e":152.025},{"w":"you","s":152.025,"e":152.185},{"w":"have","s":152.185,"e":152.345},{"w":"to","s":152.345,"e":152.505},{"w":"rule","s":152.505,"e":152.825},{"w":"out","s":152.825,"e":153.065},{"w":"the","s":153.065,"e":153.225},{"w":"boring","s":153.225,"e":153.625},{"w":"explanations.","s":153.625,"e":154.665},{"w":"Maybe","s":154.905,"e":155.225},{"w":"those","s":155.225,"e":155.465},{"w":"knees","s":155.465,"e":155.785},{"w":"were","s":155.785,"e":156.025},{"w":"simply","s":156.025,"e":156.345},{"w":"going","s":156.345,"e":156.585},{"w":"to","s":156.585,"e":156.745},{"w":"improve","s":156.745,"e":157.145},{"w":"on","s":157.145,"e":157.305},{"w":"their","s":157.305,"e":157.465},{"w":"own.","s":157.465,"e":157.945}]},{"speaker":"Ethan","start":158.28,"end":166.082,"text":"And she does it again — to rule out. To eliminate a possibility until only the truth is left. Doctors live by this phrase.","words":[{"w":"And","s":158.28,"e":158.425},{"w":"she","s":158.425,"e":158.585},{"w":"does","s":158.585,"e":158.825},{"w":"it","s":158.825,"e":158.985},{"w":"again","s":158.985,"e":159.545},{"w":"—","s":159.545,"e":159.625},{"w":"to","s":159.625,"e":159.785},{"w":"rule","s":159.785,"e":160.105},{"w":"out.","s":160.105,"e":160.665},{"w":"To","s":160.825,"e":161.065},{"w":"eliminate","s":161.065,"e":161.465},{"w":"a","s":161.465,"e":161.705},{"w":"possibility","s":161.705,"e":162.185},{"w":"until","s":162.185,"e":162.585},{"w":"only","s":162.585,"e":162.825},{"w":"the","s":162.825,"e":162.985},{"w":"truth","s":162.985,"e":163.305},{"w":"is","s":163.305,"e":163.465},{"w":"left.","s":163.465,"e":163.705},{"w":"Doctors","s":164.33,"e":164.81},{"w":"live","s":164.81,"e":165.13},{"w":"by","s":165.13,"e":165.29},{"w":"this","s":165.29,"e":165.53},{"w":"phrase.","s":165.53,"e":166.082}]},{"speaker":"Sarah","start":166.382,"end":170.98,"text":"'We've ruled out a fracture.' It's in every hospital drama ever filmed.","words":[{"w":"'We've","s":166.382,"e":166.73},{"w":"ruled","s":166.73,"e":167.05},{"w":"out","s":167.05,"e":167.29},{"w":"a","s":167.29,"e":167.53},{"w":"fracture.'","s":167.53,"e":168.33},{"w":"It's","s":168.33,"e":168.65},{"w":"in","s":168.65,"e":168.81},{"w":"every","s":168.81,"e":169.13},{"w":"hospital","s":169.13,"e":169.61},{"w":"drama","s":169.61,"e":170.01},{"w":"ever","s":170.01,"e":170.41},{"w":"filmed.","s":170.41,"e":170.98}]},{"speaker":"Ethan","start":171.28,"end":182.239,"text":"But here's the thing — the trial was built to rule that out. Real surgery and fake surgery recovered the same. If time alone healed them, then the real operation added nothing.","words":[{"w":"But","s":171.28,"e":171.45},{"w":"here's","s":171.45,"e":171.69},{"w":"the","s":171.69,"e":171.85},{"w":"thing","s":171.85,"e":172.33},{"w":"—","s":172.33,"e":172.73},{"w":"the","s":172.73,"e":172.89},{"w":"trial","s":172.89,"e":173.21},{"w":"was","s":173.21,"e":173.45},{"w":"built","s":173.45,"e":173.69},{"w":"to","s":173.69,"e":173.85},{"w":"rule","s":173.85,"e":174.09},{"w":"that","s":174.09,"e":174.33},{"w":"out.","s":174.33,"e":174.81},{"w":"Real","s":175.13,"e":175.45},{"w":"surgery","s":175.45,"e":175.93},{"w":"and","s":175.93,"e":176.17},{"w":"fake","s":176.17,"e":176.49},{"w":"surgery","s":176.49,"e":176.89},{"w":"recovered","s":176.89,"e":177.37},{"w":"the","s":177.37,"e":177.61},{"w":"same.","s":177.61,"e":177.77},{"w":"If","s":178.345,"e":178.585},{"w":"time","s":178.585,"e":178.825},{"w":"alone","s":178.825,"e":179.145},{"w":"healed","s":179.145,"e":179.545},{"w":"them,","s":179.545,"e":180.025},{"w":"then","s":180.105,"e":180.345},{"w":"the","s":180.345,"e":180.505},{"w":"real","s":180.505,"e":180.745},{"w":"operation","s":180.745,"e":181.305},{"w":"added","s":181.305,"e":181.625},{"w":"nothing.","s":181.625,"e":182.239}]},{"speaker":"Sarah","start":182.539,"end":188.67,"text":"Which is honestly the darker headline. Not 'fake surgery works' — 'this real surgery doesn't.'","words":[{"w":"Which","s":182.539,"e":182.905},{"w":"is","s":182.905,"e":183.145},{"w":"honestly","s":183.145,"e":183.545},{"w":"the","s":183.545,"e":183.785},{"w":"darker","s":183.785,"e":184.185},{"w":"headline.","s":184.185,"e":184.985},{"w":"Not","s":185.065,"e":185.305},{"w":"'fake","s":185.305,"e":185.705},{"w":"surgery","s":185.705,"e":186.105},{"w":"works'","s":186.105,"e":186.452},{"w":"—","s":186.452,"e":186.798},{"w":"'this","s":186.798,"e":187.145},{"w":"real","s":187.145,"e":187.465},{"w":"surgery","s":187.465,"e":187.945},{"w":"doesn't.'","s":187.945,"e":188.67}]},{"speaker":"Ethan","start":188.97,"end":195.285,"text":"And that procedure was incredibly common for arthritis at the time. This study landed like a bomb in orthopedics.","words":[{"w":"And","s":188.97,"e":189.145},{"w":"that","s":189.145,"e":189.305},{"w":"procedure","s":189.305,"e":189.785},{"w":"was","s":189.785,"e":189.945},{"w":"incredibly","s":189.945,"e":190.505},{"w":"common","s":190.505,"e":190.905},{"w":"for","s":190.905,"e":191.065},{"w":"arthritis","s":191.065,"e":191.625},{"w":"at","s":191.625,"e":191.785},{"w":"the","s":191.785,"e":191.945},{"w":"time.","s":191.945,"e":192.105},{"w":"This","s":192.62,"e":192.94},{"w":"study","s":192.94,"e":193.26},{"w":"landed","s":193.26,"e":193.66},{"w":"like","s":193.66,"e":193.82},{"w":"a","s":193.82,"e":193.98},{"w":"bomb","s":193.98,"e":194.22},{"w":"in","s":194.22,"e":194.38},{"w":"orthopedics.","s":194.38,"e":195.285}]},{"speaker":"Sarah","start":195.585,"end":205.756,"text":"Okay, so now the ethical part, because this is what actually keeps me up. If deception relieves real pain, is it ever okay to lie to a patient?","words":[{"w":"Okay,","s":195.585,"e":196.14},{"w":"so","s":196.14,"e":196.3},{"w":"now","s":196.3,"e":196.62},{"w":"the","s":196.62,"e":197.02},{"w":"ethical","s":197.02,"e":197.66},{"w":"part,","s":197.66,"e":198.22},{"w":"because","s":198.22,"e":198.54},{"w":"this","s":198.54,"e":198.86},{"w":"is","s":198.86,"e":199.02},{"w":"what","s":199.02,"e":199.18},{"w":"actually","s":199.18,"e":199.58},{"w":"keeps","s":199.58,"e":199.9},{"w":"me","s":199.9,"e":200.06},{"w":"up.","s":200.06,"e":200.54},{"w":"If","s":200.86,"e":201.1},{"w":"deception","s":201.1,"e":201.82},{"w":"relieves","s":201.82,"e":202.46},{"w":"real","s":202.46,"e":202.78},{"w":"pain,","s":202.78,"e":203.42},{"w":"is","s":203.42,"e":203.66},{"w":"it","s":203.66,"e":203.82},{"w":"ever","s":203.82,"e":204.14},{"w":"okay","s":204.14,"e":204.46},{"w":"to","s":204.46,"e":204.62},{"w":"lie","s":204.62,"e":204.86},{"w":"to","s":204.86,"e":205.1},{"w":"a","s":205.1,"e":205.26},{"w":"patient?","s":205.26,"e":205.42}]},{"speaker":"Ethan","start":206.156,"end":213.029,"text":"That's the delicious question, right? If I could cure your headache with a sugar pill, but only by lying about it, should I?","words":[{"w":"That's","s":206.156,"e":206.495},{"w":"the","s":206.495,"e":206.655},{"w":"delicious","s":206.655,"e":207.135},{"w":"question,","s":207.135,"e":207.615},{"w":"right?","s":207.615,"e":208.095},{"w":"If","s":208.415,"e":208.655},{"w":"I","s":208.655,"e":208.815},{"w":"could","s":208.815,"e":208.895},{"w":"cure","s":208.895,"e":209.215},{"w":"your","s":209.215,"e":209.375},{"w":"headache","s":209.375,"e":209.695},{"w":"with","s":209.695,"e":209.855},{"w":"a","s":209.855,"e":209.935},{"w":"sugar","s":209.935,"e":210.255},{"w":"pill,","s":210.255,"e":210.815},{"w":"but","s":210.815,"e":210.975},{"w":"only","s":210.975,"e":211.215},{"w":"by","s":211.215,"e":211.455},{"w":"lying","s":211.455,"e":211.775},{"w":"about","s":211.775,"e":212.015},{"w":"it,","s":212.015,"e":212.415},{"w":"should","s":212.415,"e":212.655},{"w":"I?","s":212.655,"e":213.029}]},{"speaker":"Sarah","start":213.429,"end":221.834,"text":"No. Trust is the entire foundation of medicine. You start lying for noble reasons, and eventually you're lying for convenient ones.","words":[{"w":"No.","s":213.535,"e":214.175},{"w":"Trust","s":214.335,"e":214.735},{"w":"is","s":214.735,"e":214.975},{"w":"the","s":214.975,"e":215.135},{"w":"entire","s":215.135,"e":215.535},{"w":"foundation","s":215.535,"e":216.015},{"w":"of","s":216.015,"e":216.255},{"w":"medicine.","s":216.255,"e":216.975},{"w":"You","s":217.215,"e":217.455},{"w":"start","s":217.455,"e":217.695},{"w":"lying","s":217.695,"e":218.175},{"w":"for","s":218.175,"e":218.335},{"w":"noble","s":218.335,"e":218.735},{"w":"reasons,","s":218.735,"e":219.455},{"w":"and","s":219.455,"e":219.535},{"w":"eventually","s":219.535,"e":219.935},{"w":"you're","s":219.935,"e":220.255},{"w":"lying","s":220.255,"e":220.495},{"w":"for","s":220.495,"e":220.655},{"w":"convenient","s":220.655,"e":221.135},{"w":"ones.","s":221.135,"e":221.455}]},{"speaker":"Ethan","start":222.134,"end":227.057,"text":"Then hold on to your chair, because here's the final twist. You don't even need the lie.","words":[{"w":"Then","s":222.134,"e":222.31},{"w":"hold","s":222.31,"e":222.55},{"w":"on","s":222.55,"e":222.71},{"w":"to","s":222.71,"e":222.87},{"w":"your","s":222.87,"e":223.03},{"w":"chair,","s":223.03,"e":223.59},{"w":"because","s":223.67,"e":223.99},{"w":"here's","s":223.99,"e":224.31},{"w":"the","s":224.31,"e":224.47},{"w":"final","s":224.47,"e":224.87},{"w":"twist.","s":224.87,"e":225.43},{"w":"You","s":225.67,"e":225.83},{"w":"don't","s":225.83,"e":225.99},{"w":"even","s":225.99,"e":226.23},{"w":"need","s":226.23,"e":226.47},{"w":"the","s":226.47,"e":226.63},{"w":"lie.","s":226.63,"e":227.057}]},{"speaker":"Sarah","start":227.357,"end":229.4,"text":"Meaning what, exactly?","words":[{"w":"Meaning","s":227.43,"e":227.83},{"w":"what,","s":227.83,"e":228.55},{"w":"exactly?","s":228.55,"e":229.27}]},{"speaker":"Ethan","start":229.8,"end":243.593,"text":"Open-label placebos. Honest ones. In 2010, Harvard researchers gave people with irritable bowel syndrome pills labeled 'placebo.' They told them straight: this is inert, like sugar, no medication inside.","words":[{"w":"Open-label","s":229.8,"e":230.47},{"w":"placebos.","s":230.47,"e":231.51},{"w":"Honest","s":231.67,"e":232.07},{"w":"ones.","s":232.07,"e":232.71},{"w":"In","s":232.95,"e":233.19},{"w":"2010,","s":233.19,"e":234.005},{"w":"Harvard","s":234.005,"e":234.405},{"w":"researchers","s":234.405,"e":234.965},{"w":"gave","s":234.965,"e":235.205},{"w":"people","s":235.205,"e":235.525},{"w":"with","s":235.525,"e":235.685},{"w":"irritable","s":235.685,"e":236.165},{"w":"bowel","s":236.165,"e":236.405},{"w":"syndrome","s":236.405,"e":236.805},{"w":"pills","s":236.805,"e":237.205},{"w":"labeled","s":237.205,"e":237.605},{"w":"'placebo.'","s":237.605,"e":238.725},{"w":"They","s":238.725,"e":238.965},{"w":"told","s":238.965,"e":239.205},{"w":"them","s":239.205,"e":239.365},{"w":"straight:","s":239.365,"e":240.005},{"w":"this","s":240.165,"e":240.405},{"w":"is","s":240.405,"e":240.565},{"w":"inert,","s":240.565,"e":241.125},{"w":"like","s":241.125,"e":241.365},{"w":"sugar,","s":241.365,"e":242.085},{"w":"no","s":242.165,"e":242.405},{"w":"medication","s":242.405,"e":242.965},{"w":"inside.","s":242.965,"e":243.593}]},{"speaker":"Sarah","start":243.893,"end":246.447,"text":"And it still worked? Come on.","words":[{"w":"And","s":243.893,"e":244.085},{"w":"it","s":244.085,"e":244.325},{"w":"still","s":244.325,"e":244.725},{"w":"worked?","s":244.725,"e":245.365},{"w":"Come","s":245.765,"e":246.085},{"w":"on.","s":246.085,"e":246.245}]},{"speaker":"Ethan","start":246.747,"end":255.524,"text":"It did. The honest-placebo group reported significantly more improvement than patients who got no treatment. Knowing it was fake didn't kill the effect.","words":[{"w":"It","s":246.747,"e":246.97},{"w":"did.","s":246.97,"e":247.53},{"w":"The","s":247.69,"e":247.85},{"w":"honest-placebo","s":247.85,"e":248.73},{"w":"group","s":248.73,"e":249.05},{"w":"reported","s":249.05,"e":249.53},{"w":"significantly","s":249.53,"e":250.17},{"w":"more","s":250.17,"e":250.41},{"w":"improvement","s":250.41,"e":250.89},{"w":"than","s":250.89,"e":251.13},{"w":"patients","s":251.13,"e":251.45},{"w":"who","s":251.45,"e":251.69},{"w":"got","s":251.69,"e":251.85},{"w":"no","s":251.85,"e":252.17},{"w":"treatment.","s":252.17,"e":252.81},{"w":"Knowing","s":253.29,"e":253.61},{"w":"it","s":253.61,"e":253.77},{"w":"was","s":253.77,"e":253.93},{"w":"fake","s":253.93,"e":254.17},{"w":"didn't","s":254.17,"e":254.57},{"w":"kill","s":254.57,"e":254.81},{"w":"the","s":254.81,"e":254.97},{"w":"effect.","s":254.97,"e":255.524}]},{"speaker":"Sarah","start":255.824,"end":261.072,"text":"That genuinely breaks my brain a little. You know it's sugar, and your body responds anyway?","words":[{"w":"That","s":255.824,"e":256.09},{"w":"genuinely","s":256.09,"e":256.65},{"w":"breaks","s":256.65,"e":256.97},{"w":"my","s":256.97,"e":257.21},{"w":"brain","s":257.21,"e":257.45},{"w":"a","s":257.45,"e":257.69},{"w":"little.","s":257.69,"e":258.17},{"w":"You","s":258.33,"e":258.49},{"w":"know","s":258.49,"e":258.65},{"w":"it's","s":258.65,"e":258.89},{"w":"sugar,","s":258.89,"e":259.37},{"w":"and","s":259.37,"e":259.53},{"w":"your","s":259.53,"e":259.69},{"w":"body","s":259.69,"e":260.01},{"w":"responds","s":260.01,"e":260.33},{"w":"anyway?","s":260.33,"e":260.81}]},{"speaker":"Ethan","start":261.472,"end":271.271,"text":"The ritual seems to matter — the bottle, the routine, someone caring for you. Your brain runs its own pharmacy, and apparently it accepts theater as a valid prescription.","words":[{"w":"The","s":261.472,"e":261.575},{"w":"ritual","s":261.575,"e":261.975},{"w":"seems","s":261.975,"e":262.375},{"w":"to","s":262.375,"e":262.535},{"w":"matter","s":262.535,"e":263.095},{"w":"—","s":263.095,"e":263.175},{"w":"the","s":263.175,"e":263.255},{"w":"bottle,","s":263.255,"e":263.895},{"w":"the","s":263.895,"e":264.055},{"w":"routine,","s":264.055,"e":264.775},{"w":"someone","s":264.935,"e":265.255},{"w":"caring","s":265.255,"e":265.575},{"w":"for","s":265.575,"e":265.815},{"w":"you.","s":265.815,"e":266.295},{"w":"Your","s":266.455,"e":266.695},{"w":"brain","s":266.695,"e":266.935},{"w":"runs","s":266.935,"e":267.255},{"w":"its","s":267.255,"e":267.415},{"w":"own","s":267.415,"e":267.655},{"w":"pharmacy,","s":267.655,"e":268.375},{"w":"and","s":268.455,"e":268.615},{"w":"apparently","s":268.615,"e":269.015},{"w":"it","s":269.015,"e":269.255},{"w":"accepts","s":269.255,"e":269.575},{"w":"theater","s":269.575,"e":269.975},{"w":"as","s":269.975,"e":270.135},{"w":"a","s":270.135,"e":270.215},{"w":"valid","s":270.215,"e":270.535},{"w":"prescription.","s":270.535,"e":271.255}]},{"speaker":"Sarah","start":271.571,"end":281.556,"text":"So it's not belief, exactly. It's expectation. Conditioning. Which is still mind over matter, just... sneakier.","words":[{"w":"So","s":271.571,"e":271.735},{"w":"it's","s":271.735,"e":271.975},{"w":"not","s":271.975,"e":272.135},{"w":"belief,","s":272.135,"e":272.935},{"w":"exactly.","s":272.935,"e":273.735},{"w":"It's","s":274.055,"e":274.455},{"w":"expectation.","s":274.455,"e":275.495},{"w":"Conditioning.","s":276.295,"e":276.695},{"w":"Which","s":277.33,"e":277.73},{"w":"is","s":277.73,"e":278.05},{"w":"still","s":278.05,"e":278.53},{"w":"mind","s":278.53,"e":278.85},{"w":"over","s":278.85,"e":279.25},{"w":"matter,","s":279.25,"e":279.89},{"w":"just...","s":279.89,"e":280.37},{"w":"sneakier.","s":280.69,"e":281.556}]},{"speaker":"Ethan","start":281.856,"end":287.057,"text":"And researchers are still arguing about the mechanism, which is honestly my favorite part of science.","words":