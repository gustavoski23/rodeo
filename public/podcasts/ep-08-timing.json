":"call","s":171.74,"e":171.98},{"w":"your","s":171.98,"e":172.14},{"w":"name.","s":172.14,"e":172.7}]},{"speaker":"Sunnie","start":173.28,"end":181.92,"text":"I once killed two hours in an airport rating strangers' luggage. Ten out of ten for the lady with the leopard-print suitcase.","words":[{"w":"I","s":173.28,"e":173.58},{"w":"once","s":173.58,"e":173.9},{"w":"killed","s":173.9,"e":174.3},{"w":"two","s":174.3,"e":174.7},{"w":"hours","s":174.7,"e":175.1},{"w":"in","s":175.1,"e":175.42},{"w":"an","s":175.42,"e":175.58},{"w":"airport","s":175.58,"e":175.9},{"w":"rating","s":175.9,"e":176.3},{"w":"strangers'","s":176.3,"e":176.94},{"w":"luggage.","s":176.94,"e":177.74},{"w":"Ten","s":178.06,"e":178.3},{"w":"out","s":178.3,"e":178.54},{"w":"of","s":178.54,"e":178.62},{"w":"ten","s":178.62,"e":178.86},{"w":"for","s":178.86,"e":179.1},{"w":"the","s":179.1,"e":179.26},{"w":"lady","s":179.26,"e":179.58},{"w":"with","s":179.58,"e":179.82},{"w":"the","s":179.82,"e":179.98},{"w":"leopard-print","s":179.98,"e":180.7},{"w":"suitcase.","s":180.7,"e":181.34}]},{"speaker":"Desmond","start":182.22,"end":189.74,"text":"See, that's the whole science. And it's everywhere once you notice it. Do you know why elevators have mirrors next to them?","words":[{"w":"See,","s":182.375,"e":183.015},{"w":"that's","s":183.015,"e":183.335},{"w":"the","s":183.335,"e":183.495},{"w":"whole","s":183.495,"e":183.735},{"w":"science.","s":183.735,"e":184.375},{"w":"And","s":184.615,"e":184.775},{"w":"it's","s":184.775,"e":185.015},{"w":"everywhere","s":185.015,"e":185.415},{"w":"once","s":185.415,"e":185.655},{"w":"you","s":185.655,"e":185.815},{"w":"notice","s":185.815,"e":186.135},{"w":"it.","s":186.135,"e":186.615},{"w":"Do","s":186.935,"e":187.095},{"w":"you","s":187.095,"e":187.255},{"w":"know","s":187.255,"e":187.335},{"w":"why","s":187.335,"e":187.575},{"w":"elevators","s":187.575,"e":188.055},{"w":"have","s":188.055,"e":188.295},{"w":"mirrors","s":188.295,"e":188.695},{"w":"next","s":188.695,"e":188.935},{"w":"to","s":188.935,"e":189.095},{"w":"them?","s":189.095,"e":189.575}]},{"speaker":"Sunnie","start":190.14,"end":193.18,"text":"To check my hair? Obviously?","words":[{"w":"To","s":190.295,"e":190.535},{"w":"check","s":190.535,"e":190.935},{"w":"my","s":190.935,"e":191.175},{"w":"hair?","s":191.175,"e":191.735},{"w":"Obviously?","s":191.895,"e":192.695}]},{"speaker":"Desmond","start":193.58,"end":204.3,"text":"Well, that's the trick. Another classic story says office buildings got complaints about slow elevators, so they installed mirrors — and the complaints vanished.","words":[{"w":"Well,","s":193.735,"e":194.375},{"w":"that's","s":194.535,"e":194.935},{"w":"the","s":194.935,"e":195.175},{"w":"trick.","s":195.175,"e":195.415},{"w":"Another","s":195.92,"e":196.4},{"w":"classic","s":196.4,"e":196.88},{"w":"story","s":196.88,"e":197.12},{"w":"says","s":197.12,"e":197.44},{"w":"office","s":197.44,"e":197.84},{"w":"buildings","s":197.84,"e":198.16},{"w":"got","s":198.16,"e":198.48},{"w":"complaints","s":198.48,"e":198.88},{"w":"about","s":198.88,"e":199.2},{"w":"slow","s":199.2,"e":199.6},{"w":"elevators,","s":199.6,"e":200.48},{"w":"so","s":200.72,"e":200.8},{"w":"they","s":200.8,"e":201.04},{"w":"installed","s":201.04,"e":201.44},{"w":"mirrors","s":201.44,"e":202.24},{"w":"—","s":202.24,"e":202.32},{"w":"and","s":202.32,"e":202.64},{"w":"the","s":202.64,"e":202.8},{"w":"complaints","s":202.8,"e":203.2},{"w":"vanished.","s":203.2,"e":204.08}]},{"speaker":"Sunnie","start":204.6,"end":214.92,"text":"Because everyone was too busy admiring themselves to notice the wait. Humans are so easy. I'm offended on our behalf.","words":[{"w":"Because","s":204.72,"e":205.44},{"w":"everyone","s":205.52,"e":206.4},{"w":"was","s":206.4,"e":206.72},{"w":"too","s":206.72,"e":207.04},{"w":"busy","s":207.04,"e":207.36},{"w":"admiring","s":207.36,"e":207.92},{"w":"themselves","s":207.92,"e":208.64},{"w":"to","s":208.64,"e":208.96},{"w":"notice","s":208.96,"e":209.44},{"w":"the","s":209.44,"e":209.68},{"w":"wait.","s":209.68,"e":210},{"w":"Humans","s":210.645,"e":211.125},{"w":"are","s":211.125,"e":211.445},{"w":"so","s":211.445,"e":211.765},{"w":"easy.","s":211.765,"e":212.485},{"w":"I'm","s":212.645,"e":212.965},{"w":"offended","s":212.965,"e":213.445},{"w":"on","s":213.445,"e":213.765},{"w":"our","s":213.765,"e":213.925},{"w":"behalf.","s":213.925,"e":214.565}]},{"speaker":"Desmond","start":215.22,"end":221.62,"text":"The other ingredient is information. Not knowing how long something will take is its own special torture.","words":[{"w":"The","s":215.285,"e":215.525},{"w":"other","s":215.525,"e":215.765},{"w":"ingredient","s":215.765,"e":216.325},{"w":"is","s":216.325,"e":216.565},{"w":"information.","s":216.565,"e":217.365},{"w":"Not","s":217.765,"e":218.005},{"w":"knowing","s":218.005,"e":218.325},{"w":"how","s":218.325,"e":218.565},{"w":"long","s":218.565,"e":218.805},{"w":"something","s":218.805,"e":219.285},{"w":"will","s":219.285,"e":219.445},{"w":"take","s":219.445,"e":219.685},{"w":"is","s":219.685,"e":219.845},{"w":"its","s":219.845,"e":220.085},{"w":"own","s":220.085,"e":220.245},{"w":"special","s":220.245,"e":220.645},{"w":"torture.","s":220.645,"e":221.365}]},{"speaker":"Sunnie","start":221.92,"end":230.48,"text":"Oh, absolutely. 'Your call is important to us.' Is it? Then tell me how many minutes of my life you're planning to take.","words":[{"w":"Oh,","s":222.085,"e":222.725},{"w":"absolutely.","s":222.725,"e":223.685},{"w":"'Your","s":223.685,"e":224.245},{"w":"call","s":224.245,"e":224.565},{"w":"is","s":224.565,"e":224.805},{"w":"important","s":224.805,"e":225.205},{"w":"to","s":225.205,"e":225.365},{"w":"us.'","s":225.365,"e":225.95},{"w":"Is","s":225.95,"e":226.27},{"w":"it?","s":226.27,"e":226.75},{"w":"Then","s":226.83,"e":227.15},{"w":"tell","s":227.15,"e":227.39},{"w":"me","s":227.39,"e":227.55},{"w":"how","s":227.55,"e":227.79},{"w":"many","s":227.79,"e":228.03},{"w":"minutes","s":228.03,"e":228.27},{"w":"of","s":228.27,"e":228.51},{"w":"my","s":228.51,"e":228.67},{"w":"life","s":228.67,"e":228.91},{"w":"you're","s":228.91,"e":229.23},{"w":"planning","s":229.23,"e":229.47},{"w":"to","s":229.47,"e":229.63},{"w":"take.","s":229.63,"e":230.11}]},{"speaker":"Desmond","start":230.78,"end":236.94,"text":"That's the thing — they keep you completely in the dark, and that uncertainty hurts more than the wait itself.","words":[{"w":"That's","s":230.83,"e":231.23},{"w":"the","s":231.23,"e":231.39},{"w":"thing","s":231.39,"e":231.95},{"w":"—","s":231.95,"e":232.11},{"w":"they","s":232.11,"e":232.35},{"w":"keep","s":232.35,"e":232.59},{"w":"you","s":232.59,"e":232.75},{"w":"completely","s":232.75,"e":233.15},{"w":"in","s":233.15,"e":233.31},{"w":"the","s":233.31,"e":233.47},{"w":"dark,","s":233.47,"e":233.87},{"w":"and","s":233.87,"e":234.19},{"w":"that","s":234.19,"e":234.35},{"w":"uncertainty","s":234.35,"e":234.91},{"w":"hurts","s":234.91,"e":235.23},{"w":"more","s":235.23,"e":235.47},{"w":"than","s":235.47,"e":235.63},{"w":"the","s":235.63,"e":235.71},{"w":"wait","s":235.71,"e":235.95},{"w":"itself.","s":235.95,"e":236.59}]},{"speaker":"Sunnie","start":237.24,"end":244.44,"text":"Wait, that's a good one too. 'To keep someone in the dark' — to deliberately not give them information they'd want.","words":[{"w":"Wait,","s":237.24,"e":237.95},{"w":"that's","s":237.95,"e":238.35},{"w":"a","s":238.35,"e":238.51},{"w":"good","s":238.51,"e":238.67},{"w":"one","s":238.67,"e":238.83},{"w":"too.","s":238.83,"e":239.15},{"w":"'To","s":239.15,"e":239.975},{"w":"keep","s":239.975,"e":240.215},{"w":"someone","s":240.215,"e":240.535},{"w":"in","s":240.535,"e":240.695},{"w":"the","s":240.695,"e":240.775},{"w":"dark'","s":240.775,"e":241.095},{"w":"—","s":241.095,"e":241.415},{"w":"to","s":241.415,"e":241.575},{"w":"deliberately","s":241.575,"e":242.135},{"w":"not","s":242.135,"e":242.455},{"w":"give","s":242.455,"e":242.695},{"w":"them","s":242.695,"e":242.855},{"w":"information","s":242.855,"e":2