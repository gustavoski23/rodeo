":"don't","s":129.845,"e":130.165},{"w":"buy","s":130.165,"e":130.325},{"w":"that.","s":130.325,"e":130.805},{"w":"It","s":130.805,"e":130.965},{"w":"wasn't","s":130.965,"e":131.285},{"w":"gullibility,","s":131.285,"e":132.165},{"w":"it","s":132.165,"e":132.325},{"w":"was","s":132.325,"e":132.485},{"w":"hunger.","s":132.485,"e":133.125},{"w":"When","s":133.125,"e":133.285},{"w":"you","s":133.285,"e":133.445},{"w":"want","s":133.445,"e":133.605},{"w":"to","s":133.605,"e":133.765},{"w":"belong","s":133.765,"e":134.085},{"w":"that","s":134.085,"e":134.325},{"w":"badly,","s":134.325,"e":134.965},{"w":"your","s":134.965,"e":135.205},{"w":"brain","s":135.205,"e":135.525},{"w":"quietly","s":135.525,"e":136.005},{"w":"deletes","s":136.005,"e":136.485},{"w":"every","s":136.485,"e":136.805},{"w":"red","s":136.805,"e":137.045},{"w":"flag","s":137.045,"e":137.365},{"w":"for","s":137.365,"e":137.525},{"w":"you.","s":137.525,"e":137.845}]},{"speaker":"David","start":137.845,"end":145.76,"text":"Okay, fair point. Desperation makes smart people do very dumb things. So insecurity was the entry point. That's dark.","words":[{"w":"Okay,","s":137.845,"e":138.725},{"w":"fair","s":138.725,"e":139.045},{"w":"point.","s":139.045,"e":139.605},{"w":"Desperation","s":139.605,"e":140.325},{"w":"makes","s":140.325,"e":140.645},{"w":"smart","s":140.645,"e":140.965},{"w":"people","s":140.965,"e":141.285},{"w":"do","s":141.285,"e":141.525},{"w":"very","s":141.525,"e":141.845},{"w":"dumb","s":141.845,"e":142.085},{"w":"things.","s":142.085,"e":142.325},{"w":"So","s":142.64,"e":142.88},{"w":"insecurity","s":142.88,"e":143.6},{"w":"was","s":143.6,"e":143.84},{"w":"the","s":143.84,"e":144},{"w":"entry","s":144,"e":144.32},{"w":"point.","s":144.32,"e":144.8},{"w":"That's","s":144.8,"e":145.12},{"w":"dark.","s":145.12,"e":145.76}]},{"speaker":"Alice","start":146,"end":152.72,"text":"It gets darker. When Poisson's wife got suspicious, Lustig did something brilliant. He asked for a bribe.","words":[{"w":"It","s":146,"e":146.24},{"w":"gets","s":146.24,"e":146.48},{"w":"darker.","s":146.48,"e":147.2},{"w":"When","s":147.2,"e":147.36},{"w":"Poisson's","s":147.36,"e":148.08},{"w":"wife","s":148.08,"e":148.32},{"w":"got","s":148.32,"e":148.64},{"w":"suspicious,","s":148.64,"e":149.44},{"w":"Lustig","s":149.44,"e":150},{"w":"did","s":150,"e":150.16},{"w":"something","s":150.16,"e":150.56},{"w":"brilliant.","s":150.56,"e":151.2},{"w":"He","s":151.28,"e":151.44},{"w":"asked","s":151.44,"e":151.76},{"w":"for","s":151.76,"e":151.92},{"w":"a","s":151.92,"e":152.08},{"w":"bribe.","s":152.08,"e":152.72}]},{"speaker":"David","start":152.72,"end":154.72,"text":"A bribe? Why would that help him?","words":[{"w":"A","s":152.72,"e":152.96},{"w":"bribe?","s":152.96,"e":153.6},{"w":"Why","s":153.6,"e":153.92},{"w":"would","s":153.92,"e":154.08},{"w":"that","s":154.08,"e":154.32},{"w":"help","s":154.32,"e":154.48},{"w":"him?","s":154.48,"e":154.72}]},{"speaker":"Alice","start":155.385,"end":162.905,"text":"Think about it. What kind of official demands money under the table? A real one. The corruption made the fantasy believable.","words":[{"w":"Think","s":155.385,"e":155.625},{"w":"about","s":155.625,"e":155.865},{"w":"it.","s":155.865,"e":156.345},{"w":"What","s":156.345,"e":156.585},{"w":"kind","s":156.585,"e":156.745},{"w":"of","s":156.745,"e":156.905},{"w":"official","s":156.905,"e":157.305},{"w":"demands","s":157.305,"e":157.705},{"w":"money","s":157.705,"e":158.105},{"w":"under","s":158.105,"e":158.425},{"w":"the","s":158.425,"e":158.585},{"w":"table?","s":158.585,"e":159.145},{"w":"A","s":159.225,"e":159.465},{"w":"real","s":159.465,"e":159.705},{"w":"one.","s":159.705,"e":160.265},{"w":"The","s":160.505,"e":160.745},{"w":"corruption","s":160.745,"e":161.225},{"w":"made","s":161.225,"e":161.545},{"w":"the","s":161.545,"e":161.705},{"w":"fantasy","s":161.705,"e":162.105},{"w":"believable.","s":162.105,"e":162.905}]},{"speaker":"David","start":163.065,"end":168.585,"text":"That's diabolical. Asking for a bribe as proof of authenticity. Wow.","words":[{"w":"That's","s":163.065,"e":164.345},{"w":"diabolical.","s":164.345,"e":165.385},{"w":"Asking","s":165.385,"e":165.865},{"w":"for","s":165.865,"e":166.025},{"w":"a","s":166.025,"e":166.185},{"w":"bribe","s":166.185,"e":166.505},{"w":"as","s":166.505,"e":166.745},{"w":"proof","s":166.745,"e":166.985},{"w":"of","s":166.985,"e":167.145},{"w":"authenticity.","s":167.145,"e":168.105},{"w":"Wow.","s":168.265,"e":168.585}]},{"speaker":"Alice","start":169.35,"end":178.07,"text":"So Poisson pays. The sale, the bribe, everything. Lustig takes the money, packs a suitcase, and is on a train to Vienna within hours.","words":[{"w":"So","s":169.35,"e":169.59},{"w":"Poisson","s":169.59,"e":170.15},{"w":"pays.","s":170.15,"e":170.87},{"w":"The","s":170.95,"e":171.11},{"w":"sale,","s":171.11,"e":171.67},{"w":"the","s":171.67,"e":171.75},{"w":"bribe,","s":171.75,"e":172.39},{"w":"everything.","s":172.39,"e":172.95},{"w":"Lustig","s":173.11,"e":173.67},{"w":"takes","s":173.67,"e":173.91},{"w":"the","s":173.91,"e":174.07},{"w":"money,","s":174.07,"e":174.55},{"w":"packs","s":174.55,"e":174.87},{"w":"a","s":174.87,"e":175.03},{"w":"suitcase,","s":175.03,"e":175.75},{"w":"and","s":175.75,"e":175.83},{"w":"is","s":175.83,"e":176.07},{"w":"on","s":176.07,"e":176.23},{"w":"a","s":176.23,"e":176.31},{"w":"train","s":176.31,"e":176.55},{"w":"to","s":176.55,"e":176.71},{"w":"Vienna","s":176.71,"e":177.11},{"w":"within","s":177.11,"e":177.51},{"w":"hours.","s":177.51,"e":178.07}]},{"speaker":"David","start":178.15,"end":181.43,"text":"And now the poor man realizes he's been taken for a ride.","words":[{"w":"And","s":178.15,"e":178.31},{"w":"now","s":178.31,"e":178.55},{"w":"the","s":178.55,"e":178.71},{"w":"poor","s":178.71,"e":179.03},{"w":"man","s":179.03,"e":179.35},{"w":"realizes","s":179.35,"e":179.99},{"w":"he's","s":179.99,"e":180.39},{"w":"been","s":180.39,"e":180.55},{"w":"taken","s":180.55,"e":180.87},{"w":"for","s":180.87,"e":181.03},{"w":"a","s":181.03,"e":181.19},{"w":"ride.","s":181.19,"e":181.43}]},{"speaker":"Alice","start":182.005,"end":190.805,"text":"Exactly — to take someone for a ride. It means to deceive someone, to cheat them completely. Poor Poisson got taken on the ride of the century.","words":[{"w":"Exactly","s":182.005,"e":182.965},{"w":"—","s":182.965,"e":183.005},{"w":"to","s":182.965,"e":183.125},{"w":"take","s":183.125,"e":183.445},{"w":"someone","s":183.445,"e":183.765},{"w":"for","s":183.765,"e":183.925},{"w":"a","s":183.925,"e":184.085},{"w":"ride.","s":184.085,"e":184.725},{"w":"It","s":184.725,"e":184.885},{"w":"means","s":184.885,"e":185.125},{"w":"to","s":185.125,"e":185.285},{"w":"deceive","s":185.285,"e":185.765},{"w":"someone,","s":185.765,"e":186.405},{"w":"to","s":186.405,"e":186.485},{"w":"cheat","s":186.485,"e":186.805},{"w":"them","s":186.805,"e":186.965},{"w":"completely.","s":186.965,"e":187.765},{"w":"Poor","s":187.925,"e":188.165},{"w":"Poisson","s":188.165,"e":188.725},{"w":"got","s":188.725,"e":188.965},{"w":"taken","s":188.965,"e":189.285},{"w":"on","s":189.285,"e":189.445},{"w":"the","s":189.445,"e":189.605},{"w":"ride","s":189.605,"e":189.845},{"w":"of","s":189.845,"e":190.005},{"w":"the","s":190.005,"e":190.085},{"w":"century.","s":190.085,"e":190.805}]},{"speaker":"David","start":190.885,"end":196.725,"text":"Like when my cousin bought a vintage watch online that turned out to be plastic. He got taken for a ride.","words":[{"w":"Like","s":190.885,"e":191.045},{"w":"when","s":191.045,"e":191.285},{"w":"my","s":191.285,"e":191.525},{"w":"cousin","s":191.525,"e":191.925},{"w":"bought","s":191.925,"e":192.165},{"w":"a","s":192.165,"e":192.325},{"w":"vintage","s":192.325,"e":192.805},{"w":"watch","s":192.805,"e":193.125},{"w":"online","s":193.125,"e":193.605},{"w":"that","s":193.605,"e":193.925},{"w":"turned","s":193.925,"e":194.165},{"w":"out","s":194.165,"e":194.405},{"w":"to","s":194.405,"e":194.485},{"w":"be","s":194.485,"e":194.645},{"w":"plastic.","s":194.645,"e":195.365},{"w":"He","s":195.365,"e":195.605},{"w":"got","s":195.605,"e":195.845},{"w":"taken","s":195.845,"e":196.165},{"w":"for","s":196.165,"e":196.325},{"w":"a","s":196.325,"e":196.485},{"w":"ride.","s":196.485,"e":196.725}]},{"speaker":"Alice","start":197.67,"end":203.59,"text":"Exactly. Now here's the twist that makes this story legendary. Poisson never went to the police.","words":[{"w":"Exactly.","s":197.67,"e":198.39},{"w":"Now","s":198.55,"e":198.79},{"w":"here's","s":198.79,"e":199.11},{"w":"the","s":199.11,"e":199.27},{"w":"twist","s":199.27,"e":199.59},{"w":"that","s":199.59,"e":199.75},{"w":"makes","s":199.75,"e":200.07},{"w":"this","s":200.07,"e":200.23},{"w":"story","s":200.23,"e":200.55},{"w":"legendary.","s":200.55,"e":201.51},{"w":"Poisson","s":201.51,"e":202.07},{"w":"never","s":202.07,"e":202.47},{"w":"went","s":202.47,"e":202.63},{"w":"to","s":202.63,"e":202.79},{"w":"the","s":202.79,"e":202.95},{"w":"police.","s":202.95,"e":203.59}]},{"speaker":"David","start":203.59,"end":207.11,"text":"What? He lost a fortune and said nothing? Why?","words":[{"w":"What?","s":203.59,"e":204.15},{"w":"He","s":204.15,"e":204.39},{"w":"lost","s":204.39,"e":204.71},{"w":"a","s":204.71,"e":204.87},{"w":"fortune","s":204.87,"e":205.19},{"w":"and","s":205.19,"e":205.43},{"w":"said","s":205.43,"e":205.67},{"w":"nothing?","s":205.67,"e":206.31},{"w":"Why?","s":206.47,"e":207.11}]},{"speaker":"Alice","start":207.11,"end":213.555,"text":"Shame. Pure shame. Imagine telling all of Paris you bought the Eiffel Tower from a stranger in a hotel room.","words":[{"w":"Shame.","s":207.11,"e":207.83},{"w":"Pure","s":207.83,"e":208.15},{"w":"shame.","s":208.15,"e":208.79},{"w":"Imagine","s":208.79,"e":209.27},{"w":"telling","s":209.27,"e":209.67},{"w":"all","s":209.67,"e":209.83},{"w":"of","s":209.83,"e":209.99},{"w":"Paris","s":209.99,"e":210.31},{"w":"you","s":210.31,"e":210.55},{"w":"bought","s":210.55,"e":210.79},{"w":"the","s":210.79,"e":211.99},{"w":"Eiffel","s":210.915,"e":211.235},{"w":"Tower","s":211.235,"e":211.635},{"w":"from","s":211.635,"e":211.795},{"w":"a","s":211.795,"e":211.955},{"w":"stranger","s":211.955,"e":212.355},{"w":"in","s":212.355,"e":212.515},{"w":"a","s":212.515,"e":212.595},{"w":"hotel","s":212.595,"e":212.995},{"w":"room.","s":212.995,"e":213.555}]},{"speaker":"David","start":213.955,"end":218.355,"text":"The headlines would have destroyed him. So his silence was the price of his dignity.","words":[{"w":"The","s":213.955,"e":214.115},{"w":"headlines","s":214.115,"e":214.595},{"w":"would","s":214.595,"e":214.835},{"w":"have","s":214.835,"e":214.995},{"w":"destroyed","s":214.995,"e":215.395},{"w":"him.","s":215.395,"e":215.875},{"w":"So","s":215.875,"e":216.035},{"w":"his","s":216.035,"e":216.355},{"w":"silence","s":216.355,"e":216.755},{"w":"was","s":216.755,"e":216.915},{"w":"the","s":216.915,"e":217.075},{"w":"price","s":217.075,"e":217.315},{"w":"of","s":217.315,"e":217.475},{"w":"his","s":217.475,"e":217.715},{"w":"dignity.","s":217.715,"e":218.355}]},{"speaker":"Alice","start":218.435,"end":226.08,"text":"And when Lustig read the newspapers and saw... nothing? No scandal, no manhunt? He made an absolutely insane decision.","words":[{"w":"And","s":218.435,"e":218.595},{"w":"when","s":218.595,"e":218.835},{"w":"Lustig","s":218.835,"e":219.315},{"w":"read","s":219.315,"e":219.555},{"w":"the","s":219.555,"e":219.715},{"w":"newspapers","s":219.715,"e":220.275},{"w":"and","s":220.275,"e":220.515},{"w":"saw...","s":220.515,"e":220.755},{"w":"nothing?","s":220.755,"e":221.955},{"w":"No","s":221.955,"e":222.195},{"w":"scandal,","s":222.195,"e":222.835},{"w":"no","s":222.835,"e":222.995},{"w":"manhunt?","s":222.995,"e":223.715},{"w":"He","s":223.715,"e":223.875},{"w":"made","s":223.875,"e":224.115},{"w":"an","s":224.115,"e":225.315},{"w":"absolutely","s":224.4,"e":224.88},{"w":"insane","s":224.88,"e":225.44},{"w":"decision.","s":225.44,"e":226.08}]},{"speaker":"David","start":226.32,"end":227.92,"text":"No. Don't tell me.","words":[{"w":"No.","s":226.32,"e":226.88},{"w":"Don't","s":226.88,"e":227.2},{"w":"tell","s":227.2,"e":227.36},{"w":"me.","s":227.36,"e":227.92}]},{"speaker":"Alice","start":228.16,"end":234.96,"text":"He went back to Paris and tried to sell the tower again. Same script, same hotel, a handful of new dealers.","words":[{"w":"He","s":228.16,"e":228.4},{"w":"went","s":228.4,"e":228.64},{"w":"back","s":228.64,"e":228.8},{"w":"to","s":228.8,"e":228.96},{"w":"Paris","s":228.96,"e":229.36},{"w":"and","s":229.36,"e":229.6},{"w":"tried","s":229.6,"e":229.84},{"w":"to","s":229.84,"e":230},{"w":"sell","s":230,"e":230.24},{"w":"the","s":230.24,"e":230.4},{"w":"tower","s":230.4,"e":230.72},{"w":"again.","s":230.72,"e":231.28},{"w":"Same","s":231.44,"e":231.76},{"w":"script,","s":231.76,"e":232.4},{"w":"same","s":232.4,"e":232.64},{"w":"hotel,","s":232.64,"e":233.36},{"w":"a","s":233.44,"e":233.6},{"w":"handful","s":233.6,"e":233.84},{"w":"of","s":233.84,"e":234.08},{"w":"new","s":234.08,"e":234.32},{"w":"dealers.","s":234.32,"e":234.96}]},{"speaker":"David","start":235.2,"end":238.72,"text":"The audacity is off the charts. Did he pull it off a second time?","words":[{"w":"The","s":235.2,"e":235.36},{"w":"audacity","s":235.36,"e":236},{"w":"is","s":236,"e":236.24},{"w":"off","s":236.24,"e":236.48},{"w":"the","s":236.48,"e":236.64},{"w":"charts.","s":236.64,"e":237.2},{"w":"Did","s":237.2,"e":237.44},{"w":"he","s":237.44,"e":237.6},{"w":"pull","s":237.6,"e":237.76},{"w":"it","s":237.76,"e":237.92},{"w":"off","s":237.92,"e":238.08},{"w":"a","s":238.08,"e":238.24},{"w":"second","s":238.24,"e":238.56},{"w":"time?","s":238.56,"e":238.72}]},{"speaker":"Alice","start":239.425,"end":247.425,"text":"There it is — to pull off. You said it, I said it earlier. To pull something off means to succeed at something really difficult or risky.","words":[{"w":"There","s":239.425,"e":239.745},{"w":"it","s":239.745,"e":239.985},{"w":"is","s":239.985,"e":240.385},{"w":"—","s":240.385,"e":240.42499999999998},{"w":"to","s":240.385,"e":240.545},{"w":"pull","s":240.545,"e":240.785},{"w":"off.","s":240.785,"e":241.265},{"w":"You","s":241.265,"e":241.585},{"w":"said","s":241.585,"e":241.745},{"w":"it,","s":241.745,"e":242.065},{"w":"I","s":242.065,"e":242.145},{"w":"said","s":242.145,"e":242.385},{"w":"it","s":242.385,"e":242.545},{"w":"earlier.","s":242.545,"e":243.185},{"w":"To","s":243.185,"e":243.425},{"w":"pull","s":243.425,"e":243.665},{"w":"something","s":243.665,"e":243.985},{"w":"off","s":243.985,"e":244.225},{"w":"means","s":244.225,"e":244.545},{"w":"to","s":244.545,"e":244.785},{"w":"succeed","s":244.785,"e":245.105},{"w":"at","s":245.105,"e":245.345},{"w":"something","s":245.345,"e":245.665},{"w":"really","s":245.665,"e":245.985},{"w":"difficult","s":245.985,"e":246.465},{"w":"or","s":246.465,"e":246.705},{"w":"risky.","s":246.705,"e":247.425}]},{"speaker":"David","start":247.425,"end":254.625,"text":"Like pulling off a surprise party without anyone finding out. Or, in his case, pulling off the same impossible scam twice.","words":[{"w":"Like","s":247.425,"e":247.665},{"w":"pulling","s":247.665,"e":247.985},{"w":"off","s":247.985,"e":248.225},{"w":"a","s":248.225,"e":248.385},{"w":"surprise","s":248.385,"e":248.785},{"w":"party","s":248.785,"e":249.185},{"w":"without","s":249.185,"e":249.585},{"w":"anyone","s":249.585,"e":249.985},{"w":"finding","s":249.985,"e":250.385},{"w":"out.","s":250.385,"e":250.865},{"w":"Or,","s":250.945,"e":251.425},{"w":"in","s":251.425,"e":251.585},{"w":"his","s":251.585,"e":251.825},{"w":"case,","s":251.825,"e":252.305},{"w":"pulling","s":252.305,"e":252.625},{"w":"off","s":252.625,"e":252.865},{"w":"the","s":252.865,"e":253.025},{"w":"same","s":253.025,"e":253.265},{"w":"impossible","s":253.265,"e":253.905},{"w":"scam","s":253.905,"e":254.225},{"w":"twice.","s":254.225,"e":254.625}]},{"speaker":"Alice","start":255.25,"end":262.93,"text":"Except this time the chosen victim got suspicious, went to the police, and Lustig had to flee the country. No second payday.","words":[{"w":"Except","s":255.25,"e":255.73},{"w":"this","s":255.73,"e":256.05},{"w":"time","s":256.05,"e":256.21},{"w":"the","s":256.21,"e":256.45},{"w":"chosen","s":256.45,"e":256.85},{"w":"victim","s":256.85,"e":257.25},{"w":"got","s":257.25,"e":257.49},{"w":"suspicious,","s":257.49,"e":258.37},{"w":"went","s":258.45,"e":258.69},{"w":"to","s":258.69,"e":258.77},{"w":"the","s":258.77,"e":258.93},{"w":"police,","s":258.93,"e":259.49},{"w":"and","s":259.49,"e":259.65},{"w":"Lustig","s":259.65,"e":260.13},{"w":"had","s":260.13,"e":260.29},{"w":"to","s":260.29,"e":260.45},{"w":"flee","s":260.45,"e":260.61},{"w":"the","s":260.61,"e":260.85},{"w":"country.","s":260.85,"e":261.41},{"w":"No","s":261.41,"e":261.73},{"w":"second","s":261.73,"e":262.13},{"w":"payday.","s":262.13,"e":262.93}]},{"speaker":"David","start":263.01,"end":269.25,"text":"So one victim's shame protected him, and one victim's courage nearly caught him. That's the whole moral, isn't it?","words":[{"w":"So","s":263.01,"e":263.17},{"w":"one","s":263.17,"e":263.49},{"w":"victim's","s":263.49,"e":263.97},{"w":"shame","s":263.97,"e":264.37},{"w":"protected","s":264.37,"e":264.77},{"w":"him,","s":264.77,"e":265.41},{"w":"and","s":265.41,"e":265.49},{"w":"one","s":265.49,"e":265.81},{"w":"victim's","s":265.81,"e":266.29},{"w":"courage","s":266.29,"e":266.61},{"w":"nearly","s":266.61,"e":267.01},{"w":"caught","s":267.01,"e":267.25},{"w":"him.","s":267.25,"e":267.73},{"w":"That's","s":267.81,"e":268.13},{"w":"the","s":268.13,"e":268.21},{"w":"whole","s":268.21,"e":268.45},{"w":"moral,","s":268.45,"e":268.93},{"w":"isn't","s":268.93,"e":269.17},{"w":"it?","s":269.17,"e":269.25}]},{"speaker":"Alice","start":269.675,"end":277.675,"text":"That's what fascinates me. Con artists don't really need a perfect alibi. They need our embarrassment. Shame is their best bodyguard.","words":[{"w":"That's","s":269.675,"e":270.075},{"w":"what","s":2