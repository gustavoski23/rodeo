stic.","s":188.055,"e":188.775},{"w":"He","s":188.855,"e":189.015},{"w":"got","s":189.015,"e":189.255},{"w":"taken","s":189.255,"e":189.575},{"w":"for","s":189.575,"e":189.735},{"w":"a","s":189.735,"e":189.895},{"w":"ride.","s":189.895,"e":190.305}]},{"speaker":"Zendaya","start":190.605,"end":195.946,"text":"Exactly. Now here's the twist that makes this story legendary. Poisson never went to the police.","words":[{"w":"Exactly.","s":190.615,"e":191.415},{"w":"Now","s":191.495,"e":191.655},{"w":"here's","s":191.655,"e":192.055},{"w":"the","s":192.055,"e":192.135},{"w":"twist","s":192.135,"e":192.455},{"w":"that","s":192.455,"e":192.615},{"w":"makes","s":192.615,"e":192.855},{"w":"this","s":192.855,"e":193.095},{"w":"story","s":193.095,"e":193.335},{"w":"legendary.","s":193.335,"e":194.215},{"w":"Poisson","s":194.295,"e":194.695},{"w":"never","s":194.695,"e":195.015},{"w":"went","s":195.015,"e":195.255},{"w":"to","s":195.255,"e":195.415},{"w":"the","s":195.415,"e":195.495},{"w":"police.","s":195.495,"e":195.735}]},{"speaker":"Ethan","start":196.246,"end":200.101,"text":"What? He lost a fortune and said nothing? Why?","words":[{"w":"What?","s":196.246,"e":196.88},{"w":"He","s":197.04,"e":197.28},{"w":"lost","s":197.28,"e":197.6},{"w":"a","s":197.6,"e":197.76},{"w":"fortune","s":197.76,"e":198.16},{"w":"and","s":198.16,"e":198.32},{"w":"said","s":198.32,"e":198.56},{"w":"nothing?","s":198.56,"e":199.2},{"w":"Why?","s":199.52,"e":200.08}]},{"speaker":"Zendaya","start":200.501,"end":206.77,"text":"Shame. Pure shame. Imagine telling all of Paris you bought the Eiffel Tower from a stranger in a hotel room.","words":[{"w":"Shame.","s":200.501,"e":201.28},{"w":"Pure","s":201.28,"e":201.6},{"w":"shame.","s":201.6,"e":202.32},{"w":"Imagine","s":202.4,"e":202.8},{"w":"telling","s":202.8,"e":203.2},{"w":"all","s":203.2,"e":203.44},{"w":"of","s":203.44,"e":203.52},{"w":"Paris","s":203.52,"e":203.92},{"w":"you","s":203.92,"e":204.08},{"w":"bought","s":204.08,"e":204.32},{"w":"the",