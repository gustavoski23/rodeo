,"e":99.14},{"w":"a","s":99.14,"e":99.3},{"w":"trap.","s":99.3,"e":99.54},{"w":"Thousands","s":99.905,"e":100.385},{"w":"of","s":100.385,"e":100.545},{"w":"tons","s":100.545,"e":100.785},{"w":"of","s":100.785,"e":101.025},{"w":"iron","s":101.025,"e":101.265},{"w":"at","s":101.265,"e":101.505},{"w":"a","s":101.505,"e":101.585},{"w":"bargain","s":101.585,"e":101.985},{"w":"price?","s":101.985,"e":102.545},{"w":"Classic","s":102.545,"e":102.945},{"w":"case.","s":102.945,"e":103.585}]},{"speaker":"David","start":103.665,"end":109.905,"text":"Right, if a stranger offers you a national monument at a discount, run. But these dealers didn't run.","words":[{"w":"Right,","s":103.665,"e":104.225},{"w":"if","s":104.225,"e":104.465},{"w":"a","s":104.465,"e":104.625},{"w":"stranger","s":104.625,"e":105.025},{"w":"offers","s":105.025,"e":105.425},{"w":"you","s":105.425,"e":105.585},{"w":"a","s":105.585,"e":105.745},{"w":"national","s":105.745,"e":106.065},{"w":"monument","s":106.065,"e":106.545},{"w":"at","s":106.545,"e":106.785},{"w":"a","s":106.785,"e":106.945},{"w":"discount,","s":106.945,"e":107.585},{"w":"run.","s":107.585,"e":108.225},{"w":"But","s":108.225,"e":108.385},{"w":"these","s":108.385,"e":108.705},{"w":"dealers","s":108.705,"e":109.105},{"w":"didn't","s":109.105,"e":109.345},{"w":"run.","s":109.345,"e":109.905}]},{"speaker":"Alice","start":110.305,"end":118.05,"text":"Because Lustig had studied them. He picked his victim carefully: André Poisson, a dealer desperate to break into the Parisian elite.","words":[{"w":"Because","s":110.305,"e":110.625},{"w":"Lustig","s":110.625,"e":111.185},{"w":"had","s":111.185,"e":111.345},{"w":"studied","s":111.345,"e":111.745},{"w":"them.","s":111.745,"e":112.145},{"w":"He","s":112.145,"e":112.385},{"w":"picked","s":112.385,"e":112.625},{"w":"his","s":112.625,"e":112.785},{"w":"victim","s":112.785,"e":113.105},{"w":"carefully:","s":113.105,"e":113.905},{"w":"André","s":113.905,"e":114.305},{"w":"Poisson,","s":114.305,"e":114.945},{